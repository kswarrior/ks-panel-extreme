{
  "name": "Configuration Editor",
  "slug": "config-editor",
  "kind": "custom",
  "category": "tools",
  "description": "Visual configuration editor with validation for YAML/JSON/TOML files",
  "content_type": "html",
  "content_html": "<div class=\"ks-page\">\n<div class=\"ks-row\" style=\"justify-content:space-between;margin-bottom:0.75rem\">\n  <h2 style=\"margin:0;font-size:1.3rem;color:var(--ks-heading)\">Configuration Editor</h2>\n</div>\n<div class=\"ks-row\" style=\"margin-bottom:0.6rem\">\n  <input id=\"path\" value=\"/etc/app/config.json\" spellcheck=\"false\" style=\"flex:1;min-width:220px\" />\n  <button class=\"ks-btn ks-btn-blue\" id=\"load\">Load</button>\n</div>\n<textarea id=\"editor\" rows=\"20\" spellcheck=\"false\" style=\"width:100%;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px\">Load a file to start editing.</textarea>\n<div class=\"ks-row\" style=\"justify-content:space-between;margin-top:0.6rem\">\n  <span id=\"status\" class=\"ks-muted\" style=\"font-size:12px\"></span>\n  <button class=\"ks-btn ks-btn-green\" id=\"save\">Save (with .bak backup)</button>\n</div>\n<script>\n(function () {\n  'use strict';\n  var sdk = window.KSPageSDK;\n  if (!sdk) { document.getElementById('content').innerHTML = '<p class=\"ks-bad\">SDK unavailable.</p>'; return; }\n\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];});}\n  function el(id){return document.getElementById(id);}\n  function tok(n,f){try{var v=getComputedStyle(document.documentElement).getPropertyValue(n).trim();return v||f;}catch(e){return f;}}\n  function badge(s){var c='ks-badge';s=String(s==null?'':s).toLowerCase();if(['running','done','active','ok','up'].indexOf(s)>=0)c+=' ks-ok';else if(['stopped','exited','inactive','paused'].indexOf(s)>=0)c+=' ks-warn';else if(['errored','failed','error','dead'].indexOf(s)>=0)c+=' ks-bad';return '<span class=\"'+c+'\">'+esc(s||'unknown')+'</span>';}\n  function fmtBytes(n){if(n==null||isNaN(n))return'-';var u=['B','KB','MB','GB','TB'];var i=0;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n>=100||i===0?0:1)+' '+u[i];}\n  async function sh(cmd,timeout){var r=await KSPageSDK.shell(cmd,[],null,timeout||20);if(r&&r.error&&!r.stdout&&!r.stderr)throw new Error(r.error);return r;}\n\n  function ext(p) { var m = /\\.([A-Za-z0-9]+)$/.exec(p || ''); return m ? m[1].toLowerCase() : ''; }\n  function validate(content, p) {\n    var e = ext(p);\n    if (e !== 'json') return null; // JSON validated client-side; other formats saved as-is\n    try { JSON.parse(content); return null; } catch (err) { return 'JSON invalid: ' + ((err && err.message) || err); }\n  }\n  async function loadFile() {\n    var p = el('path').value.trim();\n    if (!p) { el('status').textContent = 'Enter a file path.'; return; }\n    el('status').textContent = 'Loading…';\n    try {\n      var r = await KSPageSDK.executeAction({ type: 'read_file', path: p });\n      if (r.ok === false) throw new Error(r.error || r.stderr || 'Read failed');\n      el('editor').value = String(r.data != null ? r.data : r.stdout ?? '');\n      el('status').innerHTML = 'Loaded <span class=\"ks-mono\">' + esc(p) + '</span> (' + fmtBytes(el('editor').value.length) + ')';\n    } catch (e) { el('status').textContent = 'Load failed: ' + ((e && e.message) || e); }\n  }\n  async function saveFile() {\n    var p = el('path').value.trim();\n    if (!p) { el('status').textContent = 'Enter a file path.'; return; }\n    var content = el('editor').value;\n    var problem = validate(content, p);\n    if (problem && !window.confirm(problem + '\\n\\nSave anyway?')) { el('status').textContent = problem; return; }\n    if (!window.confirm('Save ' + p + '? A timestamped .bak copy of the current file is kept first.')) return;\n    el('status').textContent = 'Saving…';\n    try {\n      var bak = p + '.bak-' + Date.now();\n      var cp = await KSPageSDK.executeAction({ type: 'shell', command: 'cp -p ' + JSON.stringify(p) + ' ' + JSON.stringify(bak) + ' 2>/dev/null || true' });\n      if (cp.ok === false) throw new Error(cp.error || 'Backup failed');\n      var w = await KSPageSDK.executeAction({ type: 'write_file', path: p, content: content });\n      if (w.ok === false) throw new Error(w.error || w.stderr || 'Write failed');\n      el('status').innerHTML = 'Saved. Backup: <span class=\"ks-mono\">' + esc(bak) + '</span>';\n    } catch (e) { el('status').textContent = 'Save failed: ' + ((e && e.message) || e); }\n  }\n  el('load').addEventListener('click', loadFile);\n  el('save').addEventListener('click', saveFile);\n  el('path').addEventListener('keydown', function (ev) { if (ev.key === 'Enter') loadFile(); });\n  el('status').textContent = 'Ready.';\n\n})();\ndocument.currentScript.remove();\n</script>",
  "content_markdown": "",
  "content_blocks": "",
  "icon_svg": "<path d=\"M14.2 6l-3.8 3.8 3.8 3.8M7 18a2 2 0 01-2-2V4a2 2 0 012-2h8a2 2 0 012 2v12a2 2 0 01-2 2h-3\"/>"
}
