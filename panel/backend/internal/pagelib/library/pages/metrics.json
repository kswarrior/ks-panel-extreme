{
  "name": "Metrics",
  "slug": "metrics",
  "kind": "custom",
  "category": "monitoring",
  "description": "Live CPU/memory/disk/network telemetry with charts and health bands",
  "content_type": "html",
  "content_html": "<div id=\"root\"><p class=\"ks-muted\">Loading…</p></div>\n\n<script>\n(function () {\n  'use strict';\n  var sdk = null;\n  var escf = function (s) { return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]; }); };\n\n  // ---- formatters -----------------------------------------------------------\n  function fmtBytes(bytes) {\n    var n = typeof bytes === 'number' ? bytes : parseFloat(bytes);\n    if (!isFinite(n) || n < 0) return '—';\n    var units = ['B', 'KB', 'MB', 'GB', 'TB']; var i = 0; var v = n;\n    while (v >= 1024 && i < units.length - 1) { v /= 1024; i++; }\n    return i >= 3 ? v.toFixed(1) + ' ' + units[i] : Math.round(v) + ' ' + units[i];\n  }\n  function fmtRate(bps) {\n    if (!isFinite(bps) || bps < 0) return '—';\n    var units = ['B/s', 'KB/s', 'MB/s', 'GB/s']; var i = 0; var v = bps;\n    while (v >= 1024 && i < units.length - 1) { v /= 1024; i++; }\n    return i >= 2 ? v.toFixed(1) + ' ' + units[i] : Math.round(v) + ' ' + units[i];\n  }\n  function fmtUptime(sec) {\n    if (sec == null || !isFinite(sec) || sec < 0) return '—';\n    var d = Math.floor(sec / 86400), h = Math.floor((sec % 86400) / 3600), m = Math.floor((sec % 3600) / 60);\n    if (d > 0) return d + 'd ' + h + 'h';\n    if (h > 0) return h + 'h ' + m + 'm';\n    return m + 'm';\n  }\n  function healthOf(p) {\n    if (p == null || !isFinite(p)) return 'unknown';\n    if (p >= 92) return 'danger';\n    if (p >= 80) return 'warn';\n    return 'healthy';\n  }\n\n  // ---- state ------------------------------------------------------------------\n  var RANGE_SAMPLES = { '1m': 12, '5m': 60, '15m': 180 };\n  var state = {\n    range: '5m',\n    lastSampleAt: null,\n    lastError: null,\n    loading: true,\n    initialLoad: true,\n    m: null,\n    hist: {},          // key -> [{t,v}]\n    prevNet: null\n  };\n  var base = function () { return '/api/instances/' + sdk.instance.id; };\n  function push(key, t, v) {\n    var arr = state.hist[key] || (state.hist[key] = []);\n    arr.push({ t: t, v: v });\n    var max = RANGE_SAMPLES[state.range];\n    if (arr.length > max) state.hist[key] = arr.slice(arr.length - max);\n  }\n  function trimAll() {\n    var max = RANGE_SAMPLES[state.range];\n    Object.keys(state.hist).forEach(function (k) {\n      state.hist[k] = state.hist[k].slice(Math.max(0, state.hist[k].length - max));\n    });\n  }\n\n  function poll() {\n    if (state.initialLoad) state.loading = true;\n    sdk.fetchPanel(base() + '/metrics').then(function (data) {\n      data = data || {};\n      state.m = data;\n      var now = Date.now();\n      state.lastSampleAt = now; state.lastError = null;\n\n      var cpuVal = data.cpu_pct != null ? data.cpu_pct : data.cpu;\n      if (typeof cpuVal === 'number' && isFinite(cpuVal)) push('cpu', now, cpuVal);\n\n      var memPct = data.mem_pct;\n      if (memPct == null && data.mem_used != null && data.mem_total > 0) memPct = (data.mem_used / data.mem_total) * 100;\n      if (typeof memPct === 'number' && isFinite(memPct)) push('mem', now, memPct);\n\n      var diskPct = data.disk_pct;\n      if (diskPct == null && data.disk_used != null && data.disk_total > 0) diskPct = (data.disk_used / data.disk_total) * 100;\n      if (typeof diskPct === 'number' && isFinite(diskPct)) push('disk', now, diskPct);\n\n      var rxRaw = data.net_rx != null ? data.net_rx : data.net_in;\n      var txRaw = data.net_tx != null ? data.net_tx : data.net_out;\n      if (typeof rxRaw === 'number' && typeof txRaw === 'number') {\n        var prev = state.prevNet;\n        if (prev && now > prev.t) {\n          var dt = (now - prev.t) / 1000;\n          push('netrx', now, Math.max(0, (rxRaw - prev.rx) / dt));\n          push('nettx', now, Math.max(0, (txRaw - prev.tx) / dt));\n        }\n        state.prevNet = { t: now, rx: rxRaw, tx: txRaw };\n      }\n\n      if (typeof data.load1 === 'number' && isFinite(data.load1)) push('load', now, data.load1);\n\n      if (state.initialLoad) { state.initialLoad = false; state.loading = false; }\n      render();\n    }).catch(function (e) {\n      var msg = (e && e.message) ? e.message : String(e);\n      state.lastError = msg;\n      if (state.initialLoad) { state.initialLoad = false; state.loading = false; }\n      render();\n    });\n  }\n\n  // ---- canvas primitives -------------------------------------------------------\n  function sparkline(canvas, samples, color) {\n    var ctx = canvas.getContext('2d');\n    var w = canvas.width = canvas.offsetWidth * (window.devicePixelRatio || 1);\n    var h = canvas.height = canvas.offsetHeight * (window.devicePixelRatio || 1);\n    ctx.clearRect(0, 0, w, h);\n    if (!samples || samples.length < 2) return;\n    var vals = samples.map(function (s) { return s.v; });\n    var min = Math.min(0, Math.min.apply(null, vals)), max = Math.max.apply(null, vals);\n    if (max <= min) max = min + 1;\n    ctx.beginPath();\n    for (var i = 0; i < samples.length; i++) {\n      var x = (i / (samples.length - 1)) * (w - 2) + 1;\n      var y = h - 2 - ((samples[i].v - min) / (max - min)) * (h - 4);\n      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n    }\n    ctx.strokeStyle = color; ctx.lineWidth = 1.5 * (window.devicePixelRatio || 1);\n    ctx.globalAlpha = 0.9; ctx.stroke(); ctx.globalAlpha = 1;\n  }\n\n  function areaChart(canvas, opts) {\n    var ctx = canvas.getContext('2d');\n    var dpr = window.devicePixelRatio || 1;\n    var w = canvas.width = canvas.offsetWidth * dpr;\n    var h = canvas.height = canvas.offsetHeight * dpr;\n    ctx.clearRect(0, 0, w, h);\n    var samples = opts.samples || [];\n    var maxV = opts.max || 100;\n\n    // grid lines (25/50/75%)\n    ctx.strokeStyle = 'rgba(255,255,255,0.07)';\n    ctx.lineWidth = 1;\n    [0.25, 0.5, 0.75].forEach(function (g) {\n      var y = h - g * h;\n      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();\n    });\n\n    // threshold line\n    if (opts.threshold != null && opts.threshold <= maxV) {\n      var ty = h - (opts.threshold / maxV) * h;\n      ctx.strokeStyle = 'rgba(248,113,113,0.45)';\n      ctx.setLineDash([4 * dpr, 3 * dpr]);\n      ctx.beginPath(); ctx.moveTo(0, ty); ctx.lineTo(w, ty); ctx.stroke();\n      ctx.setLineDash([]);\n    }\n\n    if (samples.length < 2) {\n      ctx.fillStyle = 'rgba(156,163,175,0.7)';\n      ctx.font = (11 * dpr) + 'px sans-serif';\n      ctx.fillText(opts.label || '', 6 * dpr, 14 * dpr);\n      return;\n    }\n\n    function xy(i) {\n      var x = (i / (samples.length - 1)) * (w - 2) + 1;\n      var y = h - 2 - (Math.min(samples[i].v, maxV) / maxV) * (h - 4);\n      return [x, y];\n    }\n\n    // optimistic linear projection (6-sample regression), dashed\n    if (opts.project !== false) {\n      var n = Math.min(6, samples.length);\n      var sx = 0, sy = 0, sxx = 0, sxy = 0;\n      for (var j = 0; j < n; j++) {\n        var idx = samples.length - n + j;\n        sx += idx; sy += samples[idx].v; sxx += idx * idx; sxy += idx * samples[idx].v;\n      }\n      var denom = (n * sxx - sx * sx);\n      if (denom !== 0) {\n        var slope = (n * sxy - sx * sy) / denom;\n        var inter = (sy - slope * sx) / n;\n        var nextIdx = samples.length; // project one step ahead of the last sample\n        var pv = inter + slope * nextIdx;\n        if (isFinite(pv) && pv >= 0) {\n          var lx = ((samples.length - 1) / Math.max(samples.length - 1, 1)) * (w - 2) + 1;\n          var ly = h - 2 - (Math.min(samples[samples.length - 1].v, maxV) / maxV) * (h - 4);\n          var px = w - 1; // project to the right edge of the plot area\n          var py = h - 2 - (Math.min(Math.max(pv, 0), maxV) / maxV) * (h - 4);\n          ctx.strokeStyle = opts.color; ctx.globalAlpha = 0.35;\n          ctx.setLineDash([3 * dpr, 3 * dpr]);\n          ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(px, py); ctx.stroke();\n          ctx.setLineDash([]); ctx.globalAlpha = 1;\n        }\n      }\n    }\n\n    // fill + line\n    ctx.beginPath();\n    for (var i2 = 0; i2 < samples.length; i2++) {\n      var p = xy(i2);\n      if (i2 === 0) ctx.moveTo(p[0], p[1]); else ctx.lineTo(p[0], p[1]);\n    }\n    ctx.strokeStyle = opts.color; ctx.lineWidth = 1.6 * dpr; ctx.stroke();\n    ctx.lineTo(w - 1, h); ctx.lineTo(1, h); ctx.closePath();\n    ctx.globalAlpha = 0.16; ctx.fillStyle = opts.color; ctx.fill(); ctx.globalAlpha = 1;\n  }\n\n  function donutSvg(pct, color, label, sub, warnAt, dangerAt) {\n    var r = 52, c = 2 * Math.PI * r;\n    var p = Math.max(0, Math.min(100, pct || 0));\n    var col = p >= dangerAt ? '#f87171' : (p >= warnAt ? '#fbbf24' : color);\n    return '<div style=\"position:relative;width:130px;height:130px;margin:8px auto\">'\n      + '<svg viewBox=\"0 0 130 130\" style=\"width:130px;height:130px;transform:rotate(-90deg)\">'\n      + '<circle cx=\"65\" cy=\"65\" r=\"' + r + '\" fill=\"none\" stroke=\"rgba(255,255,255,0.08)\" stroke-width=\"10\"/>'\n      + '<circle cx=\"65\" cy=\"65\" r=\"' + r + '\" fill=\"none\" stroke=\"' + col + '\" stroke-width=\"10\" stroke-linecap=\"round\" stroke-dasharray=\"' + (p / 100 * c) + ',' + c + '\"/>'\n      + '</svg>'\n      + '<div style=\"position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center\">'\n      + '<span class=\"ks-mono\" style=\"font-size:16px;font-weight:600;color:' + col + '\">' + escf(label) + '</span>'\n      + (sub ? '<span class=\"ks-mono ks-muted\" style=\"font-size:9px;margin-top:2px\">' + escf(sub) + '</span>' : '')\n      + '</div></div>';\n  }\n\n  // ---- render -------------------------------------------------------------------\n  function trend(cur, prev, unit, digits) {\n    if (cur == null || prev == null) return '';\n    var delta = cur - prev;\n    var arrow = delta > 0 ? '▲' : (delta < 0 ? '▼' : '•');\n    var col = delta > 0 ? '#fca5a5' : (delta < 0 ? '#6ee7b7' : '#9ca3af');\n    return '<span class=\"ks-mono\" style=\"font-size:10px;color:' + col + '\">' + arrow + ' ' + Math.abs(delta).toFixed(digits) + unit + '</span>';\n  }\n\n  function render() {\n    var m = state.m;\n    var cpuHist = state.hist.cpu || [], memHist = state.hist.mem || [], diskHist = state.hist.disk || [];\n    var rxHist = state.hist.netrx || [], txHist = state.hist.nettx || [], loadHist = state.hist.load || [];\n\n    var cpuPct = m ? (m.cpu_pct != null ? m.cpu_pct : (m.cpu != null ? m.cpu : null)) : null;\n    var memPct = m && m.mem_used != null && m.mem_total > 0 ? (m.mem_used / m.mem_total) * 100 : (m && m.mem_pct != null ? m.mem_pct : null);\n    var diskPct = m && m.disk_used != null && m.disk_total > 0 ? (m.disk_used / m.disk_total) * 100 : (m && m.disk_pct != null ? m.disk_pct : null);\n    var latestRx = rxHist.length ? rxHist[rxHist.length - 1].v : 0;\n    var latestTx = txHist.length ? txHist[txHist.length - 1].v : 0;\n\n    var overall = ['cpu', 'mem', 'disk'].map(function (k) {\n      var v = k === 'cpu' ? cpuPct : (k === 'mem' ? memPct : diskPct);\n      return healthOf(v != null ? v : undefined);\n    }).reduce(function (worst, hh) {\n      var order = { unknown: 0, healthy: 1, warn: 2, danger: 3 };\n      return order[hh] > order[worst] ? hh : worst;\n    }, 'healthy');\n    var oMeta = {\n      healthy: { c: '#6ee7b7', label: 'Overall · healthy', text: 'All resources within healthy thresholds.' },\n      warn: { c: '#fbbf24', label: 'Overall · watch', text: 'One or more resources crossed the warning threshold.' },\n      danger: { c: '#f87171', label: 'Overall · critical', text: 'A resource is in the danger band — investigate soon.' },\n      unknown: { c: '#9ca3af', label: 'Overall · no data', text: 'Waiting for the first sample from the edge.' }\n    }[overall];\n\n    var lastLabel = state.lastSampleAt == null ? '—' : Math.max(0, Math.round((Date.now() - state.lastSampleAt) / 1000)) + 's ago';\n\n    var html = ''\n      + '<div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap\">'\n      + '<h2 style=\"font-size:20px;font-weight:600;color:#fff;margin:0\">Metrics</h2>'\n      + '<div style=\"display:flex;align-items:center;gap:8px;flex-wrap:wrap\">'\n      + '<div style=\"display:flex;background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:2px;font-size:11px\">'\n      + ['1m', '5m', '15m'].map(function (r) {\n        return '<button type=\"button\" data-range=\"' + r + '\" style=\"padding:3px 10px;border:none;border-radius:4px;background:' + (state.range === r ? 'rgba(255,255,255,0.1)' : 'transparent') + ';color:' + (state.range === r ? '#fff' : '#9ca3af') + ';cursor:pointer;font-family:inherit\">' + r + '</button>';\n      }).join('')\n      + '</div>'\n      + '<span class=\"ks-mono\" style=\"display:inline-flex;align-items:center;gap:6px;font-size:11px;color:#e5e7eb;background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:5px 8px\">'\n      + '<span style=\"width:6px;height:6px;border-radius:50%;background:' + (state.lastError ? '#f87171' : '#34d399') + (state.lastError ? '' : ';animation:ks-pulse 1.2s ease-in-out infinite') + '\"></span>'\n      + (state.lastError ? 'stale' : 'live') + ' · ' + lastLabel + '</span>'\n      + '<button type=\"button\" class=\"ks-btn\" data-action=\"refresh\">Refresh</button>'\n      + '</div></div>';\n\n    if (state.lastError) {\n      html += '<div class=\"ks-card\" style=\"border-color:rgba(185,28,28,0.4)!important;margin-top:12px;font-size:12px;color:#fecaca\">'\n        + '<div style=\"font-weight:600;margin-bottom:2px\">Last poll failed</div>'\n        + '<div style=\"color:#fca5a5cc;word-break:break-all\">' + escf(state.lastError) + '</div>'\n        + '<div style=\"color:#fca5a580;margin-top:4px\">Showing the last-known values until the next successful refresh</div></div>';\n    }\n\n    // health banner\n    html += '<div class=\"ks-card\" style=\"margin-top:12px;display:flex;align-items:center;justify-content:space-between;gap:12px;'\n      + (overall === 'danger' ? 'border-color:rgba(185,28,28,0.4)!important;' : overall === 'warn' ? 'border-color:rgba(180,83,9,0.4)!important;' : '') + '\">'\n      + '<div style=\"display:flex;align-items:center;gap:12px;min-width:0\">'\n      + '<span class=\"ks-badge\" style=\"color:' + oMeta.c + ';border-color:' + oMeta.c + '55\">' + escf(oMeta.label) + '</span>'\n      + '<span class=\"ks-muted\" style=\"font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap\">' + escf(oMeta.text) + '</span></div>'\n      + '<div class=\"ks-mono ks-hidden-sm\" style=\"display:flex;gap:14px;font-size:11px;color:#9ca3af;flex-shrink:0\">'\n      + '<span>CPU <span style=\"color:#e5e7eb\">' + (cpuPct != null ? cpuPct.toFixed(1) + '%' : '—') + '</span></span>'\n      + '<span>MEM <span style=\"color:#e5e7eb\">' + (memPct != null ? memPct.toFixed(1) + '%' : '—') + '</span></span>'\n      + '<span>DSK <span style=\"color:#e5e7eb\">' + (diskPct != null ? diskPct.toFixed(1) + '%' : '—') + '</span></span>'\n      + '</div></div>';\n\n    // tiles\n    function tileDef(key, label, value, sub, accent, color, hist, health, trendUnit, digits) {\n      var last = hist.length ? hist[hist.length - 1].v : null;\n      var prev = hist.length > 1 ? hist[hist.length - 2].v : null;\n      var ring = health === 'danger' ? 'box-shadow:inset 0 0 0 1px rgba(248,113,113,0.35);'\n        : health === 'warn' ? 'box-shadow:inset 0 0 0 1px rgba(251,191,36,0.35);'\n        : health === 'unknown' ? '' : 'box-shadow:inset 0 0 0 1px rgba(110,231,183,0.18);';\n      return '<div class=\"ks-card\" style=\"' + ring + 'display:flex;flex-direction:column;gap:6px\">'\n        + '<div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:4px\">'\n        + '<span class=\"ks-muted\" style=\"font-size:10px;text-transform:uppercase;letter-spacing:.04em;overflow:hidden;text-overflow:ellipsis\">' + escf(label) + '</span>'\n        + (hist.length > 1 ? trend(last, prev, trendUnit, digits) : '')\n        + '</div>'\n        + '<div class=\"ks-mono\" style=\"font-size:22px;font-weight:600;color:' + accent + ';line-height:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">' + escf(value) + '</div>'\n        + (sub ? '<div class=\"ks-mono ks-muted\" style=\"font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">' + escf(sub) + '</div>' : '')\n        + (hist.length > 1 ? '<canvas data-spark=\"' + key + '\" style=\"width:100%;height:26px;display:block\"></canvas>' : '')\n        + '</div>';\n    }\n    html += '<div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px;margin-top:12px\">'\n      + tileDef('t-cpu', 'CPU', cpuPct != null ? cpuPct.toFixed(1) + '%' : '—', '', '#7dd3fc', '#7dd3fc', cpuHist, healthOf(cpuPct), '%', 1)\n      + tileDef('t-mem', 'Memory', memPct != null ? memPct.toFixed(1) + '%' : '—', m && m.mem_used != null ? fmtBytes(m.mem_used) + ' / ' + fmtBytes(m.mem_total) : '', '#6ee7b7', '#6ee7b7', memHist, healthOf(memPct), '%', 1)\n      + tileDef('t-disk', 'Disk', diskPct != null ? diskPct.toFixed(1) + '%' : '—', m && m.disk_used != null ? fmtBytes(m.disk_used) + ' / ' + fmtBytes(m.disk_total) : '', '#fcd34d', '#fcd34d', diskHist, healthOf(diskPct), '%', 1)\n      + tileDef('t-load', 'Load (1m)', m && m.load1 != null ? Number(m.load1).toFixed(2) : '—', '', '#c4b5fd', '#c4b5fd', loadHist, healthOf(m && m.load1 != null ? Math.min(100, m.load1 * 25) : undefined), '', 2)\n      + tileDef('t-uptime', 'Uptime', fmtUptime(m ? m.uptime : undefined), '', '#e5e7eb', '#e5e7eb', [], 'unknown')\n      + tileDef('t-net', 'Net RX / TX', fmtRate(latestRx) + ' / ' + fmtRate(latestTx), '', '#f0abfc', '#f0abfc', rxHist, 'unknown');\n\n    html += '</div>';\n\n    // area charts row\n    function chartCard(id, title, note, pts, samples, maxV, color, threshold, unit, label) {\n      return '<div class=\"ks-card\"><div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:8px\">'\n        + '<div><h3 style=\"font-size:13px;font-weight:600;color:#fff;margin:0\">' + title + '</h3>'\n        + '<p class=\"ks-muted\" style=\"font-size:11px;margin:2px 0 0\">' + note + '</p></div>'\n        + '<span class=\"ks-mono ks-muted\" style=\"font-size:10px\">' + samples.length + ' pts</span></div>'\n        + '<canvas data-chart=\"' + id + '\" style=\"width:100%;height:180px;display:block\"></canvas></div>';\n    }\n    html += '<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px;margin-top:12px\">'\n      + chartCard('cpu', 'CPU', 'Optimistic projection dashed · warning at 80%', 'cpu', cpuHist, 100, '#7dd3fc', 80)\n      + chartCard('mem', 'Memory', 'Warning at 85% · danger at 95%', 'mem', memHist, 100, '#6ee7b7', 85)\n      + chartCard('disk', 'Disk', 'Warning at 80% · danger at 92%', 'disk', diskHist, 100, '#fcd34d', 80);\n\n    html += '</div>';\n\n    // gauges row\n    html += '<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:12px\">'\n      + '<div class=\"ks-card\"><h3 style=\"font-size:13px;font-weight:600;color:#fff;margin:0 0 4px\">Memory donut</h3>'\n      + donutSvg(memPct || 0, '#6ee7b7', memPct != null ? memPct.toFixed(1) + '%' : '—', m && m.mem_used != null ? fmtBytes(m.mem_used) + '/' + fmtBytes(m.mem_total) : '', 75, 90) + '</div>'\n      + '<div class=\"ks-card\"><h3 style=\"font-size:13px;font-weight:600;color:#fff;margin:0 0 4px\">Disk donut</h3>'\n      + donutSvg(diskPct || 0, '#fcd34d', diskPct != null ? diskPct.toFixed(1) + '%' : '—', m && m.disk_used != null ? fmtBytes(m.disk_used) + '/' + fmtBytes(m.disk_total) : '', 80, 92) + '</div>'\n      + '<div class=\"ks-card\"><h3 style=\"font-size:13px;font-weight:600;color:#fff;margin:0 0 4px\">Network throughput</h3>'\n      + '<div style=\"display:flex;flex-direction:column;gap:8px;padding:8px 0\">'\n      + '<div><div style=\"display:flex;align-items:center;gap:8px;font-size:11px\" class=\"ks-mono\"><span style=\"width:14px;height:2px;background:#f0abfc;display:inline-block\"></span><span class=\"ks-muted\">RX in</span><span style=\"color:#f0abfc;font-size:13px\">' + fmtRate(latestRx) + '</span></div>'\n      + '<canvas data-chart=\"rx\" style=\"width:100%;height:56px;display:block\"></canvas></div>'\n      + '<div><div style=\"display:flex;align-items:center;gap:8px;font-size:11px\" class=\"ks-mono\"><span style=\"width:14px;height:2px;background:#22d3ee;display:inline-block\"></span><span class=\"ks-muted\">TX out</span><span style=\"color:#22d3ee;font-size:13px\">' + fmtRate(latestTx) + '</span></div>'\n      + '<canvas data-chart=\"tx\" style=\"width:100%;height:56px;display:block\"></canvas></div>'\n      + '</div></div>';\n\n    html += '</div>';\n    html += '<p class=\"ks-muted\" style=\"font-size:10px;text-align:center;padding-top:10px;margin:0\">Window: last '\n      + (state.range === '1m' ? '1 minute' : state.range === '5m' ? '5 minutes' : '15 minutes') + ' · '\n      + RANGE_SAMPLES[state.range] + ' samples max · refreshed every 5s · projected points use a 6-sample linear regression.</p>';\n\n    document.getElementById('root').innerHTML = html;\n\n    // wire canvases after insertion\n    Array.prototype.forEach.call(document.querySelectorAll('[data-spark]'), function (cv) {\n      var key = cv.getAttribute('data-spark').replace('t-', '');\n      var map = { cpu: ['#7dd3fc'], mem: ['#6ee7b7'], disk: ['#fcd34d'], load: ['#c4b5fd'], uptime: ['#e5e7eb'], net: ['#f0abfc'] };\n      var histMap = { cpu: cpuHist, mem: memHist, disk: diskHist, load: loadHist, uptime: [], net: rxHist };\n      sparkline(cv, histMap[key], map[key][0]);\n    });\n    Array.prototype.forEach.call(document.querySelectorAll('[data-chart]'), function (cv) {\n      var id = cv.getAttribute('data-chart');\n      if (id === 'cpu') areaChart(cv, { samples: cpuHist.map(function (s) { return { v: Math.min(s.v, 100) }; }), max: 100, color: '#7dd3fc', threshold: 80, label: 'CPU %' });\n      else if (id === 'mem') areaChart(cv, { samples: memHist.map(function (s) { return { v: Math.min(s.v, 100) }; }), max: 100, color: '#6ee7b7', threshold: 85, label: 'MEM %' });\n      else if (id === 'disk') areaChart(cv, { samples: diskHist.map(function (s) { return { v: Math.min(s.v, 100) }; }), max: 100, color: '#fcd34d', threshold: 80, label: 'DSK %' });\n      else if (id === 'rx') areaChart(cv, { samples: rxHist, max: Math.max(1, Math.max(0, Math.max.apply(null, rxHist.map(function (s) { return s.v; }).concat([0]))) * 1.2), color: '#f0abfc', label: 'RX (in)', project: false });\n      else if (id === 'tx') areaChart(cv, { samples: txHist, max: Math.max(1, Math.max(0, Math.max.apply(null, txHist.map(function (s) { return s.v; }).concat([0]))) * 1.2), color: '#22d3ee', label: 'TX (out)', project: false });\n    });\n\n    Array.prototype.forEach.call(document.querySelectorAll('[data-range]'), function (b) {\n      b.addEventListener('click', function () {\n        state.range = b.getAttribute('data-range');\n        trimAll(); render();\n      });\n    });\n    Array.prototype.forEach.call(document.querySelectorAll('[data-action=\"refresh\"]'), function (b) { b.addEventListener('click', poll); });\n  }\n\n  function start(s) {\n    sdk = s;\n    render();\n    poll();\n    setInterval(poll, 5000);\n    // Redraw canvases when the container is resized (bitmaps otherwise stretch).\n    var rt = null;\n    window.addEventListener('resize', function () {\n      if (rt) clearTimeout(rt);\n      rt = setTimeout(render, 200);\n    });\n  }\n\n  if (window.KSPageSDK) start(window.KSPageSDK);\n  else window.addEventListener('ks-page-sdk-ready', function () { start(window.KSPageSDK); }, { once: true });\n\n  var st = document.createElement('style');\n  st.textContent = '@keyframes ks-spin{to{transform:rotate(360deg)}}@keyframes ks-pulse{0%,100%{opacity:1}50%{opacity:.35}}';\n  document.head.appendChild(st);\n})();\n</script>\n",
