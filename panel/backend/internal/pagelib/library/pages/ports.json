{
  "name": "Ports",
  "slug": "ports",
  "kind": "custom",
  "category": "networking",
  "description": "Listening sockets reported by the edge inspect endpoint",
  "content_type": "html",
  "content_html": "<div id=\"root\"><p class=\"ks-muted\">Loading…</p></div>\n\n<script>\n(function () {\n  'use strict';\n  var sdk = null;\n  function esc(s) { return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]; }); }\n\n  var state = { rows: [], loading: true, error: '', loadedOnce: false };\n  var base = function () { return '/api/instances/' + sdk.instance.id; };\n\n  function stateColor(st) {\n    var s = String(st || '').toUpperCase();\n    if (s === 'LISTEN') return 'var(--ks-ok)';\n    if (s === 'ESTABLISHED') return 'var(--ks-info)';\n    if (s === 'TIME_WAIT' || s === 'CLOSE_WAIT') return 'var(--ks-warn)';\n    if (s.indexOf('SYN') === 0 || s.indexOf('FIN') === 0 || s === 'CLOSING' || s === 'LAST_ACK') return 'var(--ks-purple)';\n    return 'var(--ks-muted)';\n  }\n  function protoColor(proto) { return String(proto).toLowerCase() === 'tcp' ? 'var(--ks-info)' : 'var(--ks-pink)'; }\n\n  function load() {\n    state.loading = true;\n    if (!state.loadedOnce) state.error = '';\n    render();\n    sdk.fetchPanel(base() + '/ports')\n      .then(function (data) {\n        var rows = Array.isArray(data) ? data : (data && Array.isArray(data.ports) ? data.ports : []);\n        state.rows = rows;\n        state.loading = false; state.loadedOnce = true; render();\n      })\n      .catch(function (e) {\n        state.loading = false; state.loadedOnce = true;\n        state.error = (e && e.message) || 'Failed to load ports';\n        render();\n      });\n  }\n\n  function chip(label, value, color) {\n    return '<span class=\"ks-mono\" style=\"display:inline-flex;align-items:center;gap:4px;padding:2px 6px;border-radius:4px;background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.1);font-size:11px\">'\n      + '<span class=\"ks-muted\">' + label + '</span><span style=\"color:' + (color || 'var(--ks-body)') + '\">' + esc(value) + '</span></span>';\n  }\n\n  function render() {\n    var html = ''\n      + '<div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap\">'\n      + '<h2 style=\"font-size:20px;font-weight:600;color:var(--ks-heading);margin:0\">Ports</h2>'\n      + '<button type=\"button\" class=\"ks-btn\" data-action=\"refresh\"' + (state.loading ? ' disabled' : '') + '>Refresh</button>'\n      + '</div>';\n\n    if (state.error) html += '<p style=\"font-size:12px;color:var(--ks-bad);margin-top:10px\">' + esc(state.error) + '</p>';\n\n    if (state.loading && state.rows.length === 0) {\n      html += '<div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;margin-top:12px\">';\n      for (var i = 0; i < 6; i++) {\n        html += '<div class=\"ks-card\"><div style=\"height:14px;width:50%;background:rgba(255,255,255,0.08);border-radius:4px;margin-bottom:12px\"></div>'\n          + '<div style=\"height:10px;width:66%;background:rgba(255,255,255,0.08);border-radius:4px;margin-bottom:8px\"></div>'\n          + '<div style=\"height:10px;width:33%;background:rgba(255,255,255,0.08);border-radius:4px\"></div></div>';\n      }\n      html += '</div>';\n    } else if (state.rows.length === 0) {\n      html += '<div class=\"ks-card\" style=\"margin-top:12px\"><p class=\"ks-muted\" style=\"font-size:12px;margin:0;padding:6px 12px\">No listening sockets reported.</p></div>';\n    } else {\n      html += '<div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;margin-top:12px\">';\n      state.rows.forEach(function (p, idx) {\n        var st = p.state || '—';\n        var sc = stateColor(st);\n        var pc = protoColor(p.proto || 'tcp');\n        html += '<div class=\"ks-card\" style=\"display:flex;flex-direction:column;gap:10px\">'\n          + '<div style=\"display:flex;align-items:flex-start;justify-content:space-between;gap:8px\">'\n          + '<div style=\"min-width:0;font-size:13px;font-weight:600;color:#fff;display:flex;align-items:center;gap:8px\">'\n          + '<span class=\"ks-mono\" style=\"font-size:10px;font-weight:400;padding:2px 6px;border-radius:4px;border:1px solid currentColor;color:' + pc + ';text-transform:uppercase\">' + esc(p.proto || 'tcp') + '</span>'\n          + '<span style=\"overflow:hidden;text-overflow:ellipsis\">' + esc(p.laddr || '—') + '</span></div>'\n          + '<span class=\"ks-mono\" style=\"flex-shrink:0;font-size:10px;padding:2px 6px;border-radius:4px;border:1px solid currentColor;color:' + sc + ';text-transform:uppercase\">' + esc(st) + '</span>'\n          + '</div>'\n          + '<div style=\"display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:11px\">'\n          + chip('Local', p.laddr || '—', 'var(--ks-body)')\n          + chip('Remote', p.raddr || '—', 'var(--ks-secondary)')\n          + (p.pid != null ? chip('PID', String(p.pid), 'var(--ks-body)') : '')\n          + '</div></div>';\n      });\n      html += '</div>';\n    }\n    document.getElementById('root').innerHTML = html;\n    Array.prototype.forEach.call(document.querySelectorAll('[data-action=\"refresh\"]'), function (b) { b.addEventListener('click', load); });\n  }\n\n  function start(s) { sdk = s; load(); setInterval(load, 5000); }\n  if (window.KSPageSDK) start(window.KSPageSDK);\n  else window.addEventListener('ks-page-sdk-ready', function () { start(window.KSPageSDK); }, { once: true });\n})();\n</script>\n",
  "content_markdown": "",
  "content_blocks": "",
  "icon_svg": "<rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"/><path d=\"M9 4v16M15 4v16M4 9h16M4 15h16\"/>"
}
