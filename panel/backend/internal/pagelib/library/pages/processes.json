{
  "name": "Processes",
  "slug": "processes",
  "kind": "custom",
  "category": "monitoring",
  "description": "Live process list inside the instance with CPU/MEM usage and kill support",
  "content_type": "html",
  "content_html": "<div id=\"root\"><p class=\"ks-muted\">Loading…</p></div>\n\n<script>\n(function () {\n  'use strict';\n  var sdk = null;\n  function esc(s) { return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]; }); }\n\n  var state = { rows: [], loading: true, error: '', expanded: {}, killing: {} };\n  var base = function () { return '/api/instances/' + sdk.instance.id; };\n\n  function load() {\n    state.loading = true; state.error = '';\n    render();\n    sdk.fetchPanel(base() + '/processes')\n      .then(function (data) { var rows = Array.isArray(data) ? data : (data && Array.isArray(data.processes) ? data.processes : []); state.rows = rows; state.loading = false; render(); })\n      .catch(function (e) { state.loading = false; state.error = (e && e.message) || 'Failed to load processes'; render(); });\n  }\n\n  function kill(pid) {\n    if (!window.confirm('Send SIGTERM to pid ' + pid + '?')) return;\n    state.killing[pid] = true; render();\n    sdk.fetchPanel(base() + '/processes/kill?pid=' + encodeURIComponent(pid), { method: 'POST' })\n      .then(function (r) {\n        if (r && r.ok === false) throw new Error('Failed to kill process ' + pid);\n        delete state.killing[pid];\n        load();\n      })\n      .catch(function (e) { delete state.killing[pid]; state.error = (e && e.message) || 'Kill failed'; render(); });\n  }\n\n  function skeleton() {\n    var out = '';\n    for (var i = 0; i < 6; i++) {\n      out += '<div class=\"ks-card\"><div style=\"height:14px;width:50%;background:rgba(255,255,255,0.08);border-radius:4px;margin-bottom:12px\"></div>'\n        + '<div style=\"height:10px;width:66%;background:rgba(255,255,255,0.08);border-radius:4px;margin-bottom:8px\"></div>'\n        + '<div style=\"height:10px;width:33%;background:rgba(255,255,255,0.08);border-radius:4px\"></div></div>';\n    }\n    return out;\n  }\n\n  function render() {\n    var html = ''\n      + '<div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap\">'\n      + '<h2 style=\"font-size:20px;font-weight:600;color:#fff;margin:0\">Processes</h2>'\n      + '<button type=\"button\" class=\"ks-btn\" data-action=\"refresh\"' + (state.loading ? ' disabled' : '') + '>Refresh</button>'\n      + '</div>';\n\n    if (state.error) html += '<p style=\"font-size:12px;color:#fca5a5;margin-top:10px\">' + esc(state.error) + '</p>';\n\n    if (state.loading) {\n      html += '<div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;margin-top:12px\">' + skeleton() + '</div>';\n    } else if (state.rows.length === 0) {\n      html += '<div class=\"ks-card\" style=\"margin-top:12px\"><p class=\"ks-muted\" style=\"font-size:12px;margin:0;padding:6px 12px\">No processes reported. The instance may be stopped or the edge\\u2019s inspect endpoint is unavailable.</p></div>';\n    } else {\n      html += '<div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;margin-top:12px\">';\n      state.rows.forEach(function (p, i) {\n        var key = p.pid + '-' + i;\n        var cmd = p.cmd || p.name || '';\n        var expanded = !!state.expanded[key];\n        var displayCmd = (!expanded && String(cmd).length > 50) ? String(cmd).substring(0, 50) + '...' : cmd;\n        html += '<div class=\"ks-card\" style=\"display:flex;flex-direction:column;gap:10px\">'\n          + '<div><div style=\"font-size:13px;font-weight:600;color:#fff\">PID ' + esc(p.pid) + '</div>'\n          + '<span class=\"ks-badge ks-mono\" style=\"margin-top:4px\">' + esc(p.user || '—') + '</span></div>'\n          + '<div style=\"display:flex;align-items:flex-start;gap:8px\"><span class=\"ks-mono ks-muted\" style=\"font-size:12px;flex-shrink:0\">Command:</span>'\n          + '<span class=\"ks-mono\" style=\"font-size:12px;color:#f3f4f6;word-break:break-all;white-space:pre-wrap\">' + esc(displayCmd) + '</span></div>'\n          + (String(cmd).length > 50\n            ? '<div><button type=\"button\" class=\"ks-btn\" data-expand=\"' + esc(key) + '\" style=\"border:none!important;background:transparent!important;padding:0!important;font-size:12px;color:#7dd3fc\">' + (expanded ? 'Show less' : 'Show more') + '</button></div>'\n            : '')\n          + '<div style=\"display:flex;align-items:center;gap:12px;font-size:11px;color:#9ca3af;padding-top:6px;border-top:1px solid rgba(255,255,255,0.06)\">'\n          + '<span><span style=\"color:#7dd3fc\">CPU</span> <span class=\"ks-mono\" style=\"font-variant-numeric:tabular-nums\">' + (p.cpu != null ? Number(p.cpu).toFixed(1) : '0.0') + '</span><span class=\"ks-muted\">%</span></span>'\n          + '<span><span style=\"color:#6ee7b7\">Mem</span> <span class=\"ks-mono\" style=\"font-variant-numeric:tabular-nums\">' + (p.mem != null ? Number(p.mem).toFixed(1) : '0.0') + '</span><span class=\"ks-muted\">%</span></span>'\n          + '<span style=\"flex:1\"></span>'\n          + '<button type=\"button\" class=\"ks-btn\"' + (state.killing[p.pid] ? ' disabled' : '') + ' data-kill=\"' + esc(p.pid) + '\" title=\"SIGTERM\" style=\"color:#fca5a5!important;border-color:rgba(185,28,28,.4)!important\">' + (state.killing[p.pid] ? 'Killing…' : 'Kill') + '</button>'\n          + '</div></div>';\n      });\n      html += '</div>';\n    }\n    document.getElementById('root').innerHTML = html;\n\n    Array.prototype.forEach.call(document.querySelectorAll('[data-action=\"refresh\"]'), function (b) { b.addEventListener('click', load); });\n    Array.prototype.forEach.call(document.querySelectorAll('[data-expand]'), function (b) {\n      b.addEventListener('click', function () {\n        var k = b.getAttribute('data-expand');\n        if (state.expanded[k]) delete state.expanded[k]; else state.expanded[k] = true;\n        render();\n      });\n    });\n    Array.prototype.forEach.call(document.querySelectorAll('[data-kill]'), function (b) {\n      b.addEventListener('click', function () { kill(b.getAttribute('data-kill')); });\n    });\n  }\n\n  function start(s) { sdk = s; load(); }\n  if (window.KSPageSDK) start(window.KSPageSDK);\n  else window.addEventListener('ks-page-sdk-ready', function () { start(window.KSPageSDK); }, { once: true });\n})();\n</script>\n",
  "content_markdown": "",
  "content_blocks": "",
  "icon_svg": "<rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><path d=\"M14 17.5h7M17.5 14v7\"/>"
}
