{
  "name": "Log Viewer",
  "slug": "log-viewer",
  "kind": "custom",
  "category": "tools",
  "description": "Advanced log viewer with filtering, search, and real-time tail",
  "content_type": "html",
  "content_html": "<div class=\"ks-page\">\n<div class=\"ks-row\" style=\"justify-content:space-between;margin-bottom:0.75rem\">\n  <h2 style=\"margin:0;font-size:1.3rem;color:var(--ks-heading)\">Log Viewer</h2>\n</div>\n<div class=\"ks-row\" style=\"margin-bottom:0.6rem\">\n  <select id=\"src\" style=\"min-width:180px\">\n    <option value=\"journal\">journalctl (system)</option>\n    <option value=\"syslog\">/var/log/syslog</option>\n    <option value=\"dmesg\">dmesg (kernel)</option>\n  </select>\n  <input id=\"filter\" placeholder=\"Filter text…\" spellcheck=\"false\" style=\"flex:1;min-width:160px\" />\n  <label style=\"display:flex;align-items:center;gap:.35rem;text-transform:none;letter-spacing:normal;font-size:.8rem;color:var(--ks-body);margin:0\">\n    <input type=\"checkbox\" id=\"live\" checked /> Live\n  </label>\n  <button class=\"ks-btn ks-btn-blue\" id=\"reload\">Reload</button>\n</div>\n<div class=\"ks-card\" style=\"padding:0\"><pre id=\"out\" style=\"max-height:480px;overflow:auto;margin:0;padding:.75rem;font-size:12px\">Loading…</pre></div>\n<script>\n(function () {\n  'use strict';\n  var sdk = window.KSPageSDK;\n  if (!sdk) { document.getElementById('content').innerHTML = '<p class=\"ks-bad\">SDK unavailable.</p>'; return; }\n\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];});}\n  function el(id){return document.getElementById(id);}\n  function tok(n,f){try{var v=getComputedStyle(document.documentElement).getPropertyValue(n).trim();return v||f;}catch(e){return f;}}\n  function badge(s){var c='ks-badge';s=String(s==null?'':s).toLowerCase();if(['running','done','active','ok','up'].indexOf(s)>=0)c+=' ks-ok';else if(['stopped','exited','inactive','paused'].indexOf(s)>=0)c+=' ks-warn';else if(['errored','failed','error','dead'].indexOf(s)>=0)c+=' ks-bad';return '<span class=\"'+c+'\">'+esc(s||'unknown')+'</span>';}\n  function fmtBytes(n){if(n==null||isNaN(n))return'-';var u=['B','KB','MB','GB','TB'];var i=0;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n>=100||i===0?0:1)+' '+u[i];}\n  async function sh(cmd,timeout){var r=await KSPageSDK.shell(cmd,[],null,timeout||20);if(r&&r.error&&!r.stdout&&!r.stderr)throw new Error(r.error);return r;}\n\n  function sourceCmd() {\n    var n = 300;\n    switch (el('src').value) {\n      case 'syslog': return 'tail -n ' + n + ' /var/log/syslog 2>/dev/null || echo \"(syslog not available)\"';\n      case 'dmesg': return 'dmesg 2>/dev/null | tail -n ' + n + ' || echo \"(dmesg not permitted)\"';\n      default: return 'journalctl -n ' + n + ' --no-pager 2>/dev/null || echo \"(journalctl not available)\"';\n    }\n  }\n  function highlight(line) {\n    var e = esc(line);\n    if (/\\b(err|error|fail(ed)?|critical|alert)\\b/i.test(e)) return '<span style=\"color:var(--ks-bad)\">' + e + '</span>';\n    if (/\\bwarn(ing)?\\b/i.test(e)) return '<span style=\"color:var(--ks-warn)\">' + e + '</span>';\n    return e;\n  }\n  async function load() {\n    el('out').textContent = 'Loading…';\n    try {\n      var r = await sh(sourceCmd(), 20);\n      var lines = String(r.stdout || '').split('\\n');\n      var f = el('filter').value.trim().toLowerCase();\n      if (f) lines = lines.filter(function (l) { return l.toLowerCase().indexOf(f) >= 0; });\n      el('out').innerHTML = lines.map(highlight).join('\\n') || '<span class=\"ks-muted\">(no matching lines)</span>';\n    } catch (e) {\n      el('out').textContent = 'Failed to load logs: ' + ((e && e.message) || e);\n    }\n  }\n  var iv = null;\n  function syncLive() {\n    if (iv) { clearInterval(iv); iv = null; }\n    if (el('live').checked) iv = setInterval(load, 4000);\n  }\n  ['change'].forEach(function (evName) { el('src').addEventListener(evName, load); });\n  el('filter').addEventListener('input', load);\n  el('reload').addEventListener('click', load);\n  el('live').addEventListener('change', syncLive);\n  load(); syncLive();\n  window.addEventListener('unload', function () { if (iv) clearInterval(iv); });\n\n})();\ndocument.currentScript.remove();\n</script>",
