{
  "name": "Docker Container Manager",
  "slug": "docker-manager",
  "kind": "custom",
  "category": "operations",
  "description": "Full Docker container management - start, stop, logs, inspect, stats",
  "content_type": "html",
  "content_html": "<div class=\"ks-page\">\n<div class=\"ks-row\" style=\"justify-content:space-between;margin-bottom:0.75rem\">\n  <h2 style=\"margin:0;font-size:1.3rem;color:var(--ks-heading)\">Docker Container Manager</h2>\n</div>\n<div class=\"ks-row\" style=\"margin-bottom:0.6rem\">\n  <button class=\"ks-btn ks-btn-blue\" id=\"refresh\">Refresh</button>\n  <span id=\"hint\" class=\"ks-muted\" style=\"font-size:12px\"></span>\n</div>\n<div id=\"content\" class=\"ks-muted\">Loading containers…</div>\n<script>\n(function () {\n  'use strict';\n  var sdk = window.KSPageSDK;\n  if (!sdk) { document.getElementById('content').innerHTML = '<p class=\"ks-bad\">SDK unavailable.</p>'; return; }\n\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];});}\n  function el(id){return document.getElementById(id);}\n  function tok(n,f){try{var v=getComputedStyle(document.documentElement).getPropertyValue(n).trim();return v||f;}catch(e){return f;}}\n  function badge(s){var c='ks-badge';s=String(s==null?'':s).toLowerCase();if(['running','done','active','ok','up'].indexOf(s)>=0)c+=' ks-ok';else if(['stopped','exited','inactive','paused'].indexOf(s)>=0)c+=' ks-warn';else if(['errored','failed','error','dead'].indexOf(s)>=0)c+=' ks-bad';return '<span class=\"'+c+'\">'+esc(s||'unknown')+'</span>';}\n  function fmtBytes(n){if(n==null||isNaN(n))return'-';var u=['B','KB','MB','GB','TB'];var i=0;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n>=100||i===0?0:1)+' '+u[i];}\n  async function sh(cmd,timeout){var r=await KSPageSDK.shell(cmd,[],null,timeout||20);if(r&&r.error&&!r.stdout&&!r.stderr)throw new Error(r.error);return r;}\n\n  function parsePs(out) {\n    var lines = String(out || '').trim().split('\\n').filter(Boolean);\n    if (!lines.length) return [];\n    var head = lines[0].split('|');\n    return lines.slice(1).map(function (l) {\n      var c = l.split('|');\n      return { id: c[0] || '', name: c[1] || '', image: c[2] || '', status: c[3] || '' };\n    }).filter(function (c) { return c.name; });\n  }\n  async function load() {\n    el('content').innerHTML = 'Loading containers…';\n    try {\n      var r = await KSPageSDK.docker('ps', ['-a', '--format', '{{.ID}}|{{.Names}}|{{.Image}}|{{.Status}}']);\n      if (r.ok === false) throw new Error(r.error || r.stderr || 'docker ps failed');\n      var rows = parsePs(r.stdout);\n      el('hint').textContent = rows.length + ' container(s)';\n      if (!rows.length) { el('content').innerHTML = '<p class=\"ks-muted\">No containers found (is Docker installed in this instance?).</p>'; return; }\n      el('content').innerHTML =\n        '<div class=\"ks-card\" style=\"padding:0\"><table><thead><tr><th>Name</th><th>Image</th><th>Status</th><th>Actions</th></tr></thead><tbody>' +\n        rows.map(function (c) {\n          var acts = ['start', 'stop', 'restart'].map(function (a) {\n            return '<a href=\"#\" data-act=\"' + a + '\" data-name=\"' + esc(c.name) + '\">' + a + '</a>';\n          }).join(' &nbsp; ');\n          return '<tr><td class=\"ks-mono\">' + esc(c.name) + '</td><td class=\"ks-mono\">' + esc(c.image) + '</td><td>' + badge(c.status) + '</td>' +\n            '<td>' + acts + ' &nbsp; <a href=\"#\" data-logs=\"' + esc(c.name) + '\">logs</a> &nbsp; <a href=\"#\" data-inspect=\"' + esc(c.name) + '\">inspect</a></td></tr>';\n        }).join('') + '</tbody></table></div>';\n    } catch (e) { el('content').innerHTML = '<p class=\"ks-bad\">Failed: ' + esc((e && e.message) || e) + '</p>'; }\n  }\n  async function act(a, name) {\n    if (['stop', 'restart'].indexOf(a) >= 0 && !window.confirm(a + ' container ' + name + '?')) return;\n    try {\n      var r = await KSPageSDK.docker(a, [name]);\n      if (r.ok === false) throw new Error(r.error || r.stderr || a + ' failed');\n      KSPageSDK.toast(name + ': ' + a + ' ok', 'success');\n      setTimeout(load, 800);\n    } catch (e) { KSPageSDK.toast(((e && e.message) || e), 'error'); }\n  }\n  async function show(kind, name) {\n    try {\n      var args = kind === 'logs' ? ['--tail', '150', name] : [name];\n      var cmd = kind === 'logs' ? 'logs' : 'inspect';\n      var r = await KSPageSDK.docker(cmd, args);\n      if (r.ok === false) throw new Error(r.error || r.stderr || cmd + ' failed');\n      KSPageSDK.modal({\n        title: kind + ' — ' + name,\n        content: '<pre style=\"max-height:420px;overflow:auto;font-size:12px;margin:0;white-space:pre-wrap\">' +\n          esc(String(r.stdout || r.data || '(empty)')).slice(0, 60000) + '</pre>',\n      });\n    } catch (e) { KSPageSDK.toast(((e && e.message) || e), 'error'); }\n  }\n  el('refresh').addEventListener('click', load);\n  el('content').addEventListener('click', function (ev) {\n    var a = ev.target.closest('a'); if (!a) return;\n    ev.preventDefault();\n    if (a.dataset.act) act(a.dataset.act, a.dataset.name);\n    else if (a.dataset.logs) show('logs', a.dataset.logs);\n    else if (a.dataset.inspect) show('inspect', a.dataset.inspect);\n  });\n  load();\n\n})();\ndocument.currentScript.remove();\n</script>",
  "content_markdown": "",
