{
  "name": "Monitoring Dashboard",
  "slug": "monitoring-dashboard",
  "kind": "custom",
  "category": "monitoring",
  "description": "Real-time metrics dashboard with CPU, memory, disk, and network charts",
  "content_type": "html",
  "content_html": "<div class=\"ks-page\">\n<div class=\"ks-row\" style=\"justify-content:space-between;margin-bottom:0.75rem\">\n  <h2 style=\"margin:0;font-size:1.3rem;color:var(--ks-heading)\">Monitoring Dashboard</h2>\n</div>\n<div id=\"gauges\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0.75rem\"></div>\n<div class=\"ks-card\" style=\"margin-top:0.75rem\"><h3 style=\"margin:0 0 .5rem;font-size:.95rem;color:var(--ks-heading)\">History (last 60 samples)</h3><canvas id=\"chart\" width=\"720\" height=\"160\" style=\"width:100%\"></canvas>\n<div class=\"ks-row\" style=\"margin-top:0.5rem\" id=\"legend\"></div></div>\n<p id=\"err\" class=\"ks-bad\" style=\"font-size:12px;margin:.5rem 0 0\"></p>\n<script>\n(function () {\n  'use strict';\n  var sdk = window.KSPageSDK;\n  if (!sdk) { document.getElementById('content').innerHTML = '<p class=\"ks-bad\">SDK unavailable.</p>'; return; }\n\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];});}\n  function el(id){return document.getElementById(id);}\n  function tok(n,f){try{var v=getComputedStyle(document.documentElement).getPropertyValue(n).trim();return v||f;}catch(e){return f;}}\n  function badge(s){var c='ks-badge';s=String(s==null?'':s).toLowerCase();if(['running','done','active','ok','up'].indexOf(s)>=0)c+=' ks-ok';else if(['stopped','exited','inactive','paused'].indexOf(s)>=0)c+=' ks-warn';else if(['errored','failed','error','dead'].indexOf(s)>=0)c+=' ks-bad';return '<span class=\"'+c+'\">'+esc(s||'unknown')+'</span>';}\n  function fmtBytes(n){if(n==null||isNaN(n))return'-';var u=['B','KB','MB','GB','TB'];var i=0;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n>=100||i===0?0:1)+' '+u[i];}\n  async function sh(cmd,timeout){var r=await KSPageSDK.shell(cmd,[],null,timeout||20);if(r&&r.error&&!r.stdout&&!r.stderr)throw new Error(r.error);return r;}\n\n  var hist = { cpu: [], mem: [], disk: [], net: [] };\n  var series = [\n    { key: 'cpu', label: 'CPU %', color: null },\n    { key: 'mem', label: 'MEM %', color: null },\n    { key: 'disk', label: 'DISK %', color: null },\n    { key: 'net', label: 'NET %', color: null }\n  ];\n  var base = '/api/instances/' + sdk.instance.id;\n\n  function pct(v) { return Math.max(0, Math.min(100, Number(v) || 0)); }\n\n  function poll() {\n    sdk.fetchPanel(base + '/metrics').then(function (m) {\n      el('err').textContent = '';\n      var cpu = 100 - (Number(m && m.cpu && m.cpu.idle) || 0);\n      var memPct = m && m.memory ? pct(m.memory.percent != null ? m.memory.percent : (m.memory.used / Math.max(1, m.memory.total)) * 100) : NaN;\n      var diskPct = m && m.disk ? pct(m.disk.percent != null ? m.disk.percent : (m.disk.used / Math.max(1, diskTotal(m.disk))) * 100) : NaN;\n      var netPct = m && m.network ? pct(m.network.sent_percent != null ? m.network.sent_percent : m.network.percent) : NaN;\n      push(hist, 'cpu', cpu); push(hist, 'mem', memPct); push(hist, 'disk', diskPct); push(hist, 'net', netPct);\n      render(); draw();\n    }).catch(function (e) { el('err').textContent = 'Metrics unavailable: ' + ((e && e.message) || e); });\n  }\n  function diskTotal(d) { return Number(d && (d.total || d.size)) || 1; }\n  function push(h, k, v) { if (isNaN(v)) return; h[k].push(v); if (h[k].length > 60) h[k].shift(); }\n\n  function render() {\n    el('gauges').innerHTML = series.map(function (s) {\n      var arr = hist[s.key]; var last = arr.length ? arr[arr.length - 1] : null;\n      var tone = last == null ? 'var(--ks-muted)' : last > 90 ? 'var(--ks-bad)' : last > 70 ? 'var(--ks-warn)' : 'var(--ks-ok)';\n      return '<div class=\"ks-card\"><div class=\"ks-muted\" style=\"font-size:11px;text-transform:uppercase\">' + esc(s.label) + '</div>' +\n        '<div style=\"font-size:1.6rem;font-weight:600;color:' + tone + '\">' + (last == null ? '--' : last.toFixed(1)) + '%</div>' +\n        '<div class=\"ks-bar\"><span style=\"width:' + (last || 0) + '%;background:' + tone + '\"></span></div></div>';\n    }).join('');\n  }\n\n  function draw() {\n    var cv = el('chart'), ctx = cv.getContext('2d');\n    ctx.clearRect(0, 0, cv.width, cv.height);\n    ctx.strokeStyle = 'rgba(255,255,255,0.08)';\n    ctx.strokeRect(0.5, 0.5, cv.width - 1, cv.height - 1);\n    el('legend').innerHTML = '';\n    series.forEach(function (s) {\n      if (!s.color) s.color = tok('--ks-' + (s.key === 'cpu' ? 'info' : s.key === 'mem' ? 'ok' : s.key === 'disk' ? 'warn' : 'purple'), '#38bdf8');\n      var dot = '<span class=\"ks-badge\" style=\"border-color:' + s.color + '\">' + esc(s.label) + '</span>';\n      el('legend').innerHTML += dot;\n      var arr = hist[s.key]; if (arr.length < 2) return;\n      ctx.beginPath(); ctx.strokeStyle = s.color; ctx.lineWidth = 1.5;\n      for (var i = 0; i < arr.length; i++) {\n        var x = (i / 59) * (cv.width - 8) + 4;\n        var y = cv.height - 6 - (pct(arr[i]) / 100) * (cv.height - 14);\n        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n      }\n      ctx.stroke();\n    });\n  }\n\n  render(); draw(); poll();\n  var iv = setInterval(poll, 5000);\n  window.addEventListener('unload', function () { clearInterval(iv); });\n\n})();\ndocument.currentScript.remove();\n</script>",
  "content_markdown": "",
  "content_blocks": "",
  "icon_svg": "<path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/>"
}
