{
  "name": "Terminal",
  "slug": "terminal",
  "kind": "custom",
  "category": "console",
  "description": "Live shell into the instance over the panel WebSocket bridge",
  "content_type": "html",
  "content_html": "<div id=\"root\"></div>\n\n<script>\n(function () {\n  'use strict';\n  var sdk = null;\n  var ws = null;\n  var state = 'connecting'; // connecting | connected | reconnecting | closed | error\n  var attempt = 0;\n  var timer = null;\n  var lastOpenAt = 0;\n\n  // screen model: array of line strings (ANSI-stripped is NOT used — we keep\n  // per-line HTML). currentLine accumulates until \\n or \\r.\n  var lines = [];\n  var cur = '';\n  var maxLines = 3000;\n\n  function b64ToBytes(b64) {\n    try {\n      var bin = atob(b64); var bytes = new Uint8Array(bin.length);\n      for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return bytes;\n    } catch (e) { return new Uint8Array(0); }\n  }\n  function strToB64(s) {\n    try { return btoa(unescape(encodeURIComponent(s))); } catch (e) { return btoa(s); }\n  }\n  function bytesToStr(bytes) {\n    var out = '';\n    for (var i = 0; i < bytes.length; i++) out += String.fromCharCode(bytes[i]);\n    try { return decodeURIComponent(escape(out)); } catch (e) { return out; }\n  }\n\n  // ---- minimal ANSI -> HTML -------------------------------------------------\n  function ansiToHtml(text) {\n    var parts = String(text).split(/\\x1b\\[/);\n    var out = esc(parts[0]);\n    for (var i = 1; i < parts.length; i++) {\n      var seg = parts[i];\n      var m = seg.match(/^([0-9;]*)([A-Za-z])/);\n      if (!m) { out += esc('\\x1b[' + seg); continue; }\n      var code = m[2];\n      var nums = m[1].split(';').filter(Boolean).map(Number);\n      if (code === 'm') {\n        var open = '';\n        var close = false;\n        if (nums.length === 0) nums = [0];\n        for (var k = 0; k < nums.length; k++) {\n          var n = nums[k];\n          if (n === 0) { close = true; }\n          else if (n === 1) open += 'font-weight:600;';\n          else if (n === 3) open += 'font-style:italic;';\n          else if (n === 4) open += 'text-decoration:underline;';\n          else if (n >= 30 && n <= 37) open += 'color:' + PALETTE[n - 30] + ';';\n          else if (n === 39) open += 'color:var(--ks-secondary,#d4d4d4)';\n          else if (n >= 90 && n <= 97) open += 'color:' + PALETTE[n - 90 + 8] + ';';\n          else if (n >= 40 && n <= 47) { /* bg — skip */ }\n        }\n        if (close && nums.length === 1) out += '</span>';\n        else if (open) out += '<span style=\"' + open + '\">';\n      } else if (code === 'K') {\n        // erase to end of line — trim the rest of the current segment output\n        out += '';\n      } else if (code === 'J' && (nums[0] === 2 || m[1] === '')) {\n        clearScreen();\n        out += '';\n      }\n      // non-SGR sequences after their params are consumed and dropped\n      out += esc(seg.slice(m[0].length)).replace(/<\\/?span[^>]*>/g, '');\n    }\n    return out;\n  }\n  function esc(s) {\n    return String(s == null ? '' : s)\n      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  }\n  var PALETTE = ['#3a3a3a', '#f48771', '#89e789', '#ffea7c', '#75beff', '#c586c0', '#79d7da', '#e8e8e8',\n    '#6e6b6b', '#f48771', '#89e789', '#ffea7c', '#75beff', '#c586c0', '#79d7da', '#ffffff'];\n\n  // ---- feed -----------------------------------------------------------------\n  var dirty = false;\n  function feed(text) {\n    var i = 0;\n    while (i < text.length) {\n      var ch = text[i];\n      if (ch === '\\r') {\n        // CRLF is ONE newline: commit the line and swallow the following LF.\n        if (text[i + 1] === '\\n') { commitLine(true); i += 2; continue; }\n        commitLine(false); i++; continue;\n      }\n      if (ch === '\\n') { commitLine(true); i++; continue; }\n      if (ch === '\\x1b' && text[i + 1] === '[') {\n        // consume the whole sequence here so \\x1b[2J works across chunk splits\n        var m = text.slice(i + 2).match(/^([0-9;]*)([A-Za-z])/);\n        if (m) {\n          if (m[2] === 'J') { clearScreen(); }\n          cur += '\\x1b[' + m[0];\n          // hand to ansiToHtml at render time via cur accumulation:\n          i += 2 + m[0].length; continue;\n        }\n      }\n      cur += ch;\n      i++;\n    }\n    dirty = true;\n    renderScreen();\n  }\n  function commitLine(newlineAfter) {\n    if (cur === '') {\n      if (newlineAfter) { lines.push('&nbsp;'); trim(); dirty = true; }\n      return;\n    }\n    // split accumulated content on any embedded SGR sequences and convert\n    lines.push(ansiToHtml(cur));\n    cur = '';\n    if (newlineAfter) { lines.push(''); }\n    trim();\n    dirty = true;\n  }\n  function trim() {\n    if (lines.length > maxLines) lines.splice(0, lines.length - maxLines);\n  }\n  function clearScreen() {\n    lines = []; cur = ''; dirty = true;\n  }\n\n  // ---- render ---------------------------------------------------------------\n  var screenEl = null;\n  function renderScreen() {\n    if (!dirty || !screenEl) return;\n    dirty = false;\n    var html = lines.join('\\n');\n    if (cur !== '') html += (html ? '\\n' : '') + ansiToHtml(cur);\n    var pre = document.getElementById('term-pre');\n    if (pre) {\n      var atBottom = pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 24;\n      pre.innerHTML = '<code>' + html.split('\\n').join('<br>') + '</code>';\n      if (atBottom) pre.scrollTop = pre.scrollHeight;\n    }\n  }\n  setInterval(function () { renderScreen(); }, 120);\n\n  function statusLabel() {\n    switch (state) {\n      case 'connected': return '<span style=\"color:var(--ks-ok)\">● attached</span>';\n      case 'connecting': return '<span style=\"color:var(--ks-info)\">● connecting…</span>';\n      case 'reconnecting': return '<span style=\"color:var(--ks-warn)\">● reconnecting</span>';\n      case 'error': return '<span style=\"color:var(--ks-bad)\">● error</span>';\n      default: return '<span class=\"ks-muted\">● ' + esc((sdk && sdk.instance && sdk.instance.status) || '') + '</span>';\n    }\n  }\n\n  function render() {\n    var inst = sdk.instance;\n    var host = inst.node_name || ('node-' + (inst.node_id != null ? inst.node_id : '?'));\n    var user = inst.kind === 'docker' ? 'root' : 'ubuntu';\n    var ext = (inst.name || 'session');\n    document.getElementById('root').innerHTML = ''\n      + '<div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px\">'\n      + '<h2 style=\"font-size:20px;font-weight:600;color:var(--ks-heading);margin:0\">Terminal</h2>'\n      + '<div style=\"display:flex;align-items:center;gap:8px\">'\n      + (state !== 'connected' ? '<button type=\"button\" id=\"btn-reconnect\" class=\"ks-btn\" title=\"Reconnect the live shell now\" style=\"border-color:var(--ks-info-line)!important;color:var(--ks-info)!important\">⟳ Reconnect</button>' : '')\n      + '<button type=\"button\" id=\"btn-clear\" class=\"ks-btn\" title=\"Clear the terminal scrollback\">Clear</button>'\n      + '</div></div>'\n\n      + '<div style=\"border-radius:10px;overflow:hidden;border:1px solid var(--ks-card-border);background:var(--ks-term-bg,#1e1e1e);box-shadow:0 8px 32px rgba(0,0,0,0.5)\">'\n      // title bar\n      + '<div style=\"display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--ks-card-bg);border-bottom:1px solid var(--ks-card-border)\">'\n      + '<span style=\"width:12px;height:12px;border-radius:50%;background:#ff5f56\"></span>'\n      + '<span style=\"width:12px;height:12px;border-radius:50%;background:#ffbd2e\"></span>'\n      + '<span style=\"width:12px;height:12px;border-radius:50%;background:#27c93f\"></span>'\n      + '<span class=\"ks-mono\" style=\"margin-left:8px;font-size:12px;color:var(--ks-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">' + user + '@' + esc(host) + ': ~ — terminal</span>'\n      + '</div>'\n      // tab strip\n      + '<div style=\"display:flex;align-items:center;background:var(--ks-input-bg);border-bottom:1px solid var(--ks-card-border)\">'\n      + '<span style=\"display:inline-flex;align-items:center;gap:6px;padding:6px 12px;font-size:12px;color:var(--ks-heading,#fff);background:var(--ks-term-bg,#1e1e1e);border-right:1px solid var(--ks-card-border)\">'\n      + '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:12px;height:12px;stroke:var(--ks-info)\"><path d=\"m4 17 6-6-6-6\"/><path d=\"M12 19h8\"/></svg>'\n      + 'sh — ' + esc(ext.slice(0, 16) || 'session')\n      + '</span></div>'\n      // body\n      + '<div id=\"term-pre\" tabindex=\"0\" style=\"background:var(--ks-term-bg,#1e1e1e);color:var(--ks-secondary,#d4d4d4);font-family:\\'JetBrains Mono\\',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;line-height:1.25;padding:10px 10px 6px;height:26rem;overflow:auto;outline:none;cursor:text;user-select:text;-webkit-user-select:text\"></div>'\n      // status bar\n      + '<div style=\"display:flex;align-items:center;justify-content:space-between;padding:4px 12px;background:var(--ks-info);color:var(--ks-heading,#fff);font-size:11px\">'\n      + '<span class=\"ks-mono\">' + statusLabel() + '</span>'\n      + '<span class=\"ks-mono\" style=\"white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-left:12px\">' + esc(ext.slice(0, 16) || '—') + ' · ' + esc((inst.config && inst.config.image) || 'image') + '</span>'\n      + '</div>'\n      + '</div>';\n\n    screenEl = document.getElementById('term-pre');\n    var pre = document.getElementById('term-pre');\n    dirty = true; renderScreen();\n    pre.addEventListener('mousedown', function () { setTimeout(function () { pre.focus(); }, 0); });\n\n    var bc = document.getElementById('btn-clear');\n    if (bc) bc.addEventListener('click', function () { clearScreen(); renderScreen(); });\n    var br = document.getElementById('btn-reconnect');\n    if (br) br.addEventListener('click', function () { attempt = 0; open(); });\n  }\n\n  // ---- keyboard ---------------------------------------------------------------\n  document.addEventListener('keydown', function (ev) {\n    if (!screenEl || !ws || ws.readyState !== 1) return;\n    if ((ev.ctrlKey || ev.metaKey) && ev.key !== 'Control' && ev.key !== 'Meta') {\n      var k = ev.key.toLowerCase();\n      var code = null;\n      if (k === 'c') code = '\\x03';\n      else if (k === 'd') code = '\\x04';\n      else if (k === 'l') code = '\\x0c';\n      else if (k === 'a') code = '\\x01';\n      else if (k === 'e') code = '\\x05';\n      else if (k === 'u') code = '\\x15';\n      else if (k === 'w') code = '\\x17';\n      else if (k === 'z') code = '\\x1a';\n      if (code !== null) {\n        ev.preventDefault();\n        ws.send(JSON.stringify({ type: 'stdin', data: strToB64(code) }));\n      }\n      return;\n    }\n    if (ev.altKey) return;\n    var seq = null;\n    if (ev.key === 'Enter') seq = '\\r';\n    else if (ev.key === 'Backspace') seq = '\\x7f';\n    else if (ev.key === 'Tab') seq = '\\t';\n    else if (ev.key === 'Escape') seq = '\\x1b';\n    else if (ev.key === 'ArrowUp') seq = '\\x1b[A';\n    else if (ev.key === 'ArrowDown') seq = '\\x1b[B';\n    else if (ev.key === 'ArrowRight') seq = '\\x1b[C';\n    else if (ev.key === 'ArrowLeft') seq = '\\x1b[D';\n    else if (ev.key === 'Home') seq = '\\x1b[H';\n    else if (ev.key === 'End') seq = '\\x1b[F';\n    else if (ev.key === 'Delete') seq = '\\x1b[3~';\n    else if (ev.key === 'PageUp') seq = '\\x1b[5~';\n    else if (ev.key === 'PageDown') seq = '\\x1b[6~';\n    else if (ev.key.length === 1) seq = ev.key;\n    if (seq !== null) {\n      ev.preventDefault();\n      ws.send(JSON.stringify({ type: 'stdin', data: strToB64(seq) }));\n    }\n  }, true);\n\n  // ---- connection ---------------------------------------------------------------\n  function colsRows() {\n    var el = document.getElementById('term-pre');\n    var cols = Math.max(40, Math.floor((el ? el.clientWidth : 800) / 7.8));\n    var rows = Math.max(12, Math.floor((el ? el.clientHeight : 400) / 16.3));\n    return { cols: cols, rows: rows };\n  }\n\n  function teardown() {\n    if (ws) {\n      ws.onopen = null; ws.onmessage = null; ws.onclose = null; ws.onerror = null;\n      try { ws.close(); } catch (e) { /* noop */ }\n    }\n    ws = null; lastOpenAt = 0;\n  }\n\n  function open() {\n    if (timer) { clearTimeout(timer); timer = null; }\n    teardown();\n    setState('connecting');\n    try {\n      ws = sdk.connectWS();\n    } catch (e) {\n      setState('error', (e && e.message) || 'Failed to open WebSocket');\n      return;\n    }\n    ws.onopen = function () { lastOpenAt = Date.now(); setState('connecting'); };\n    ws.onmessage = function (ev) {\n      if (typeof ev.data !== 'string') return;\n      var msg;\n      try { msg = JSON.parse(ev.data); } catch (e) { return; }\n      switch (msg.type) {\n        case 'ready':\n          attempt = 0;\n          setState('connected');\n          clearScreen();\n          var g = colsRows();\n          try { ws.send(JSON.stringify({ type: 'resize', cols: Number(msg.cols) || g.cols, rows: Number(msg.rows) || g.rows })); } catch (e) { /* noop */ }\n          break;\n        case 'stdout':\n        case 'stderr':\n          if (typeof msg.data === 'string') feed(bytesToStr(b64ToBytes(msg.data)));\n          break;\n        case 'exit': {\n          setState('closed');\n          var code = Number(msg.code);\n          cur = '';\n          lines.push(isFinite(code)\n            ? '<span style=\"color:var(--ks-muted)\">● process exited with code ' + code + '</span>'\n            : '<span style=\"color:var(--ks-muted)\">● session closed</span>');\n          dirty = true; break;\n        }\n        case 'error':\n          setState('error', msg.message || 'Unknown error');\n          lines.push('<span style=\"color:var(--ks-bad)\">● ' + esc(msg.message || 'error') + '</span>');\n          dirty = true;\n          break;\n        default: break;\n      }\n    };\n    ws.onerror = function () { setState('error', 'WebSocket connection failed'); };\n    ws.onclose = function () {\n      if (lastOpenAt && Date.now() - lastOpenAt > 3000) attempt = 0;\n      attempt += 1;\n      var backoff = Math.min(8000, 500 * Math.pow(2, attempt));\n      setState('reconnecting');\n      lines.push('<span style=\"color:var(--ks-warn)\">● connection dropped — reconnecting in ' + Math.round(backoff / 1000) + 's</span>');\n      dirty = true;\n      if (timer) clearTimeout(timer);\n      timer = setTimeout(open, backoff);\n      lastOpenAt = 0;\n    };\n  }\n\n  function setState(s) {\n    state = s;\n    render();\n  }\n\n  function start(s) {\n    sdk = s;\n    render();\n    open();\n    // keep geometry fresh\n    setInterval(function () {\n      if (ws && ws.readyState === 1 && state === 'connected') {\n        var g = colsRows();\n        try { ws.send(JSON.stringify({ type: 'resize', cols: g.cols, rows: g.rows })); } catch (e) { /* noop */ }\n      }\n    }, 2500);\n  }\n\n  if (window.KSPageSDK) start(window.KSPageSDK);\n  else window.addEventListener('ks-page-sdk-ready', function () { start(window.KSPageSDK); }, { once: true });\n})();\n</script>\n",
  "content_markdown": "",
  "content_blocks": "",
  "icon_svg": "<path d=\"m4 17 6-6-6-6\"/><path d=\"M12 19h8\"/>"
}
