{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--caps", "devtools"],
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": ["uvx", "serena-agent", "start-mcp-server", "--context", "ide", "--project-from-cwd"],
      "enabled": true,
      "timeout": 60000
    },
    "git": {
      "type": "local",
      "command": ["uvx", "mcp-server-git", "--repository", "."],
      "enabled": true,
      "timeout": 30000
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "sequential_thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "timeout": 30000
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "MEMORY_FILE_PATH": "{env:HOME}/.local/share/opencode/ks-panel-memory.json"
      }
    },
    "sqlite": {
      "type": "local",
      "command": ["uvx", "db-mcp-server"],
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "DB_TYPE": "sqlite",
        "DB_PATH": "./kspanel.db",
        "DB_MODE": "read-only"
      }
    },
    "docker": {
      "type": "local",
      "command": ["uvx", "mcp-server-docker"],
      "enabled": true,
      "timeout": 60000
    }
  }
}
