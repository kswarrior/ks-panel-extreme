{
  "name": "Automation",
  "slug": "automation",
  "kind": "custom",
  "category": "automation",
  "description": "Scheduled and manual jobs with recent-run history",
  "content_type": "html",
  "content_html": "<div id=\"root\"><p class=\"ks-muted\">Loading…</p></div>\n\n<script>\n(function () {\n  'use strict';\n  var sdk = null;\n  function esc(s) { return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]; }); }\n  function timeAgo(iso) {\n    if (!iso) return '—';\n    var t = new Date(iso).getTime();\n    if (isNaN(t)) return String(iso);\n    var s = Math.round((Date.now() - t) / 1000);\n    if (s < 60) return s + 's ago';\n    if (s < 3600) return Math.floor(s / 60) + 'm ago';\n    if (s < 86400) return Math.floor(s / 3600) + 'h ago';\n    return new Date(iso).toLocaleString();\n  }\n\n  var state = { jobs: [], runs: [], loading: true, error: '', busy: false, tab: 'tasks', modal: null, runResult: null, formError: '' };\n  var base = function () { return '/api/instances/' + sdk.instance.id; };\n\n  function load() {\n    state.loading = true; state.error = '';\n    render();\n    Promise.all([\n      sdk.fetchPanel(base() + '/automation/'),\n      sdk.fetchPanel(base() + '/automation/runs?limit=50')\n    ]).then(function (res) {\n      state.jobs = Array.isArray(res[0]) ? res[0] : [];\n      state.runs = Array.isArray(res[1]) ? res[1] : [];\n      state.loading = false; render();\n    }).catch(function (e) {\n      state.loading = false;\n      state.error = (e && e.message) || 'Failed to load automation';\n      render();\n    });\n  }\n\n  function remove(j) {\n    if (!window.confirm('Delete automation \"' + j.name + '\"? Run history will be removed.')) return;\n    sdk.fetchPanel(base() + '/automation/' + j.id, { method: 'DELETE' })\n      .then(load)\n      .catch(function (e) { state.error = (e && e.message) || 'Failed to delete job'; render(); });\n  }\n\n  function runNow(j) {\n    state.busy = true; state.error = ''; state.runResult = null;\n    render();\n    sdk.fetchPanel(base() + '/automation/' + j.id + '/run', { method: 'POST' })\n      .then(function (r) {\n        state.runResult = { jobId: j.id, r: r };\n        state.tab = 'runs'; state.busy = false;\n        load();\n      })\n      .catch(function (e) { state.busy = false; state.error = (e && e.message) || 'Run failed'; render(); });\n  }\n\n  function submitModal() {\n    var m = state.modal;\n    if (!m.name || !m.command) { state.formError = 'Name and command are required.'; render(); return; }\n    state.busy = true; state.formError = '';\n    render();\n    var payload = {\n      name: m.name, command: m.command, schedule: m.schedule,\n      enabled: !!m.enabled, secret_refs: m.secret_refs, timeout_sec: Number(m.timeout_sec) || 300\n    };\n    var p = m.editing\n      ? sdk.fetchPanel(base() + '/automation/' + m.editing.id, { method: 'PUT', body: JSON.stringify(payload) })\n      : sdk.fetchPanel(base() + '/automation/', { method: 'POST', body: JSON.stringify(payload) });\n    p.then(function () { state.busy = false; state.modal = null; load(); })\n      .catch(function (e) { state.busy = false; state.formError = (e && e.message) || 'Failed to save job'; render(); });\n  }\n\n  // ---- modal ---------------------------------------------------------------\n  function field(label, inputHtml, hint) {\n    return '<div><label class=\"ks-muted\" style=\"display:block;font-size:11px;text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px\">' + label + '</label>'\n      + inputHtml + (hint ? '<p class=\"ks-muted\" style=\"font-size:11px;margin:4px 0 0\">' + hint + '</p>' : '') + '</div>';\n  }\n  function buildModal() {\n    var m = state.modal;\n    if (!m) return '';\n    var inner = ''\n      + (state.formError ? '<p style=\"font-size:12px;color:#fca5a5;margin:0 0 10px\">' + esc(state.formError) + '</p>' : '')\n      + '<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px\">'\n      + field('Name', '<input id=\"f-name\" type=\"text\" value=\"' + esc(m.name) + '\" placeholder=\"Backup the world\">')\n      + field('Schedule (cron)', '<input id=\"f-sched\" type=\"text\" value=\"' + esc(m.schedule) + '\" placeholder=\"0 4 * * *\">', '5 fields, e.g. \\u201C*/10 * * * *\\u201D. Empty = manual only.')\n      + '<div style=\"grid-column:1/-1\">' + field('Command', '<textarea id=\"f-cmd\" rows=\"3\" style=\"width:100%\">' + esc(m.command) + '</textarea>', 'Run inside the instance via /bin/sh -c.') + '</div>'\n      + field('Secret refs (comma-separated)', '<input id=\"f-refs\" type=\"text\" value=\"' + esc((m.secret_refs || []).join(', ')) + '\" placeholder=\"BACKUP_S3_KEY, BACKUP_S3_SECRET\">', 'Names of vaulted secrets to inject as env.')\n      + field('Timeout (sec)', '<input id=\"f-timeout\" type=\"number\" value=\"' + esc(m.timeout_sec) + '\">')\n      + '<div style=\"display:flex;align-items:end;padding-bottom:4px\"><label style=\"display:flex;align-items:center;gap:8px;font-size:13px;color:#e5e7eb;cursor:pointer\"><input id=\"f-enabled\" type=\"checkbox\"' + (m.enabled ? ' checked' : '') + ' style=\"accent-color:#0ea5e9\"> Enabled</label></div>'\n      + '</div>';\n    return '<div style=\"position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.55)\" data-overlay=\"1\">'\n      + '<div class=\"ks-card\" style=\"width:min(92vw,600px);max-height:88vh;overflow:auto;margin:12px\" onclick=\"event.stopPropagation()\">'\n      + '<div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:14px\">'\n      + '<h3 style=\"font-size:15px;font-weight:600;color:#fff;margin:0\">' + (m.editing ? 'Edit \\u201C' + esc(m.editing.name) + '\\u201D' : 'Create task') + '</h3>'\n      + '<button type=\"button\" class=\"ks-modal-close\" style=\"border:none;background:transparent;color:#9ca3af;font-size:18px;cursor:pointer\">✕</button></div>'\n      + inner\n      + '<div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:16px\">'\n      + '<button type=\"button\" class=\"ks-btn\" data-action=\"cancel\">Cancel</button>'\n      + '<button type=\"button\" class=\"ks-btn ks-btn-blue\" data-action=\"submit\"' + (state.busy ? ' disabled' : '') + '>' + (state.busy ? 'Saving…' : (m.editing ? 'Save' : 'Create task')) + '</button>'\n      + '</div></div></div>';\n  }\n\n  function skeletonCard() {\n    return '<div class=\"ks-card\"><div style=\"height:14px;width:50%;background:rgba(255,255,255,0.08);border-radius:4px;margin-bottom:12px\"></div>'\n      + '<div style=\"height:10px;width:66%;background:rgba(255,255,255,0.08);border-radius:4px;margin-bottom:8px\"></div>'\n      + '<div style=\"height:10px;width:33%;background:rgba(255,255,255,0.08);border-radius:4px\"></div></div>';\n  }\n  function pre(text, cls) {\n    return '<pre class=\"ks-mono\" style=\"margin:0;font-size:12px;background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.06);border-radius:6px;padding:8px;white-space:pre-wrap;word-break:break-all;overflow:auto;max-height:96px;color:' + (cls || '#d1d5db') + '\">' + esc(text || '') + '</pre>';\n  }\n\n  function render() {\n    var html = ''\n      + '<div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap\">'\n      + '<h2 style=\"font-size:20px;font-weight:600;color:#fff;margin:0\">Automation</h2>'\n      + '<div style=\"display:flex;gap:8px\">'\n      + '<button type=\"button\" class=\"ks-btn ks-btn-blue\" data-action=\"create\">+ Create</button>'\n      + '<button type=\"button\" class=\"ks-btn\" data-action=\"refresh\"' + (state.loading ? ' disabled' : '') + '>Refresh</button>'\n      + '</div></div>';\n\n    if (state.error) html += '<p style=\"font-size:12px;color:#fca5a5;margin-top:10px\">' + esc(state.error) + '</p>';\n\n    // tabs\n    html += '<div style=\"display:flex;align-items:center;gap:4px;border-bottom:1px solid rgba(255,255,255,0.1);margin-top:12px\">'\n      + [['tasks', 'Tasks'], ['runs', 'Recent runs']].map(function (t) {\n        var on = state.tab === t[0];\n        return '<button type=\"button\" data-tab=\"' + t[0] + '\" style=\"padding:8px 16px;font-size:14px;border:none;border-bottom:2px solid ' + (on ? '#fff' : 'transparent') + ';background:transparent;color:' + (on ? '#fff' : '#9ca3af') + ';cursor:pointer;margin-bottom:-1px;font-family:inherit\">' + t[1] + '</button>';\n      }).join('')\n      + '</div><div style=\"margin-top:12px\">';\n\n    if (state.tab === 'tasks') {\n      if (state.loading) {\n        html += '<div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px\">';\n        for (var i = 0; i < 3; i++) html += skeletonCard();\n        html += '</div>';\n      } else if (state.jobs.length === 0) {\n        html += '<div class=\"ks-card\"><p class=\"ks-muted\" style=\"font-size:12px;margin:0;padding:6px 12px\">No tasks yet. Click \\u201CCreate\\u201D to add one.</p></div>';\n      } else {\n        html += '<div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px\">';\n        state.jobs.forEach(function (j) {\n          html += '<div class=\"ks-card\" style=\"display:flex;flex-direction:column;gap:10px\">'\n            + '<div style=\"display:flex;align-items:flex-start;justify-content:space-between;gap:8px\">'\n            + '<div style=\"min-width:0\"><div style=\"font-size:13px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">' + esc(j.name) + '</div>'\n            + '<span class=\"ks-badge\" style=\"margin-top:4px;color:' + (j.enabled ? '#6ee7b7' : '#d1d5db') + '\">' + (j.enabled ? 'enabled' : 'disabled') + '</span></div>'\n            + '<div style=\"display:flex;gap:4px;flex-shrink:0\">'\n            + '<button type=\"button\" class=\"ks-btn ks-btn-blue\" data-run=\"' + j.id + '\" title=\"Run now\"' + (state.busy ? ' disabled' : '') + '>▶ Run</button>'\n            + '<button type=\"button\" class=\"ks-btn\" data-edit=\"' + j.id + '\" title=\"Edit\">✎</button>'\n            + '<button type=\"button\" class=\"ks-btn\" style=\"color:#fca5a5!important;border-color:rgba(185,28,28,.4)!important\" data-del=\"' + j.id + '\" title=\"Delete\">🗑</button>'\n            + '</div></div>'\n            + '<div style=\"display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:11px;color:#9ca3af\">'\n            + '<span class=\"ks-mono\" style=\"padding:2px 6px;border-radius:4px;background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.1);color:#e5e7eb\">' + esc(j.schedule || 'manual') + '</span>'\n            + '<span title=\"Last run\">last ' + timeAgo(j.last_run_at) + '</span><span style=\"color:#4b5563\">·</span>'\n            + '<span title=\"Next run\">next ' + timeAgo(j.next_run_at) + '</span><span style=\"color:#4b5563\">·</span>'\n            + '<span>' + (j.timeout_sec || 300) + 's</span></div>'\n            + pre(j.command)\n            + ((j.secret_refs || []).length > 0\n              ? '<div style=\"display:flex;flex-wrap:wrap;gap:4px\">' + j.secret_refs.map(function (s) {\n                return '<span class=\"ks-mono\" style=\"font-size:10px;padding:2px 6px;border-radius:4px;background:rgba(120,53,15,0.3);color:#fcd34d;border:1px solid rgba(180,83,9,0.4)\">' + esc(s) + '</span>';\n              }).join('') + '</div>'\n              : '')\n            + '</div>';\n        });\n        html += '</div>';\n      }\n    } else {\n      // runs tab\n      if (state.runResult) {\n        html += '<div class=\"ks-card\" style=\"margin-bottom:12px\"><h3 style=\"font-size:13px;font-weight:600;margin:0 0 2px;color:#fff\">Last run — job #' + state.runResult.jobId + '</h3>'\n          + '<p class=\"ks-muted\" style=\"font-size:12px;margin:0 0 8px\">exit=' + esc(state.runResult.r.exit_code) + ' · ' + esc(state.runResult.r.duration_ms) + 'ms</p>'\n          + (state.runResult.r.error\n            ? pre(state.runResult.r.error, '#fca5a5')\n            : pre(state.runResult.r.stdout || '(no stdout)', '#a7f3d0'))\n          + (state.runResult.r.stderr ? pre(state.runResult.r.stderr, '#fde68a') : '')\n          + '</div>';\n      }\n      if (state.runs.length === 0) {\n        html += '<div class=\"ks-card\"><p class=\"ks-muted\" style=\"font-size:12px;margin:0;padding:6px 12px\">No runs recorded.</p></div>';\n      } else {\n        html += '<div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px\">';\n        state.runs.forEach(function (r) {\n          var failed = r.error || r.exit_code !== 0;\n          html += '<div class=\"ks-card\" style=\"display:flex;flex-direction:column;gap:10px\">'\n            + '<div style=\"display:flex;align-items:center;justify-content:space-between;gap:8px\">'\n            + '<span class=\"ks-badge\" style=\"color:' + (r.trigger === 'schedule' ? '#7dd3fc' : '#c4b5fd') + '\">' + esc(r.trigger) + '</span>'\n            + '<span class=\"ks-mono\" style=\"font-size:12px;color:' + (failed ? '#fca5a5' : '#6ee7b7') + '\">' + (r.error ? 'err' : 'exit ' + esc(r.exit_code)) + '</span></div>'\n            + pre(r.command)\n            + (r.stdout ? pre(r.stdout, '#a7f3d0') : '')\n            + (r.stderr ? pre(r.stderr, '#fde68a') : '')\n            + (r.error ? pre(r.error, '#fca5a5') : '')\n            + '<div style=\"display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#9ca3af\"><span>' + timeAgo(r.started_at) + '</span><span style=\"font-variant-numeric:tabular-nums\">' + esc(r.duration_ms) + 'ms</span></div>'\n            + '</div>';\n        });\n        html += '</div>';\n      }\n    }\n    html += '</div>';\n    html += buildModal();\n    document.getElementById('root').innerHTML = html;\n    wire();\n  }\n\n  function wire() {\n    Array.prototype.forEach.call(document.querySelectorAll('[data-tab]'), function (b) {\n      b.addEventListener('click', function () { state.tab = b.getAttribute('data-tab'); render(); });\n    });\n    var bind = function (sel, fn) { Array.prototype.forEach.call(document.querySelectorAll(sel), function (b) { b.addEventListener('click', fn); }); };\n    bind('[data-action=\"refresh\"]', load);\n    bind('[data-action=\"create\"]', function () {\n      state.formError = '';\n      state.modal = { name: '', command: '', schedule: '', enabled: true, secret_refs: [], timeout_sec: 300, editing: null };\n      render(); wireModalFields();\n    });\n    bind('[data-run]', function (ev) {\n      var id = Number(ev.currentTarget.getAttribute('data-run'));\n      var j = state.jobs.filter(function (x) { return x.id === id; })[0];\n      if (j) runNow(j);\n    });\n    bind('[data-del]', function (ev) {\n      var id = Number(ev.currentTarget.getAttribute('data-del'));\n      var j = state.jobs.filter(function (x) { return x.id === id; })[0];\n      if (j) remove(j);\n    });\n    bind('[data-edit]', function (ev) {\n      var id = Number(ev.currentTarget.getAttribute('data-edit'));\n      var j = state.jobs.filter(function (x) { return x.id === id; })[0];\n      if (!j) return;\n      state.formError = '';\n      state.modal = {\n        name: j.name, command: j.command, schedule: j.schedule, enabled: !!j.enabled,\n        secret_refs: j.secret_refs || [], timeout_sec: j.timeout_sec || 300, editing: j\n      };\n      render(); wireModalFields();\n    });\n\n    var overlay = document.querySelector('[data-overlay]');\n    if (overlay) overlay.addEventListener('click', function (ev) { if (ev.target === overlay) closeModal(); });\n    var cb = document.querySelector('.ks-modal-close');\n    if (cb) cb.addEventListener('click', closeModal);\n    var cancel = document.querySelector('[data-action=\"cancel\"]');\n    if (cancel) cancel.addEventListener('click', closeModal);\n    var sub = document.querySelector('[data-action=\"submit\"]');\n    if (sub) sub.addEventListener('click', submitModal);\n  }\n  function wireModalFields() {\n    var n = document.getElementById('f-name');\n    var c = document.getElementById('f-cmd');\n    var s = document.getElementById('f-sched');\n    var r = document.getElementById('f-refs');\n    var t = document.getElementById('f-timeout');\n    var en = document.getElementById('f-enabled');\n    if (n) n.addEventListener('input', function () { state.modal.name = n.value.trim(); });\n    if (c) c.addEventListener('input', function () { state.modal.command = c.value; });\n    if (s) s.addEventListener('input', function () { state.modal.schedule = s.value.trim(); });\n    if (r) r.addEventListener('input', function () { state.modal.secret_refs = r.value.split(',').map(function (x) { return x.trim(); }).filter(Boolean); });\n    if (t) t.addEventListener('input', function () { state.modal.timeout_sec = Number(t.value) || 300; });\n    if (en) en.addEventListener('change', function () { state.modal.enabled = en.checked; });\n    if (n) n.focus();\n  }\n  function closeModal() { state.modal = null; state.formError = ''; render(); }\n\n  function start(s) { sdk = s; load(); }\n  if (window.KSPageSDK) start(window.KSPageSDK);\n  else window.addEventListener('ks-page-sdk-ready', function () { start(window.KSPageSDK); }, { once: true });\n\n  var st = document.createElement('style');\n  st.textContent = '@keyframes ks-pulse{0%,100%{opacity:1}50%{opacity:.45}}';\n  document.head.appendChild(st);\n})();\n</script>\n",
  "content_markdown": "",
  "content_blocks": "",
  "icon_svg": "<circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1\"/>"
}
