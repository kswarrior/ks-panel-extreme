  "icon_svg": "<path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z\"/>",
  "pages": [
    {
      "path": "edit",
      "name": "Editor",
      "content_type": "html",
      "content_html": "<div class=\"ks-card\" style=\"max-width:960px;margin:0 auto\">\n  <div class=\"ks-row\" style=\"justify-content:space-between\">\n    <h2 style=\"margin:0;font-size:18px\">File Editor</h2>\n    <span id=\"status\" class=\"ks-muted\" style=\"font-size:12px\"></span>\n  </div>\n  <div class=\"ks-row\" style=\"margin-top:12px\">\n    <input id=\"path\" placeholder=\"/path/to/file.conf\" style=\"flex:1;min-width:240px\">\n    <button class=\"ks-btn ks-btn-blue\" id=\"loadBtn\">Load</button>\n    <button class=\"ks-btn ks-btn-green\" id=\"saveBtn\">Save</button>\n  </div>\n  <textarea id=\"editor\" spellcheck=\"false\" style=\"width:100%;min-height:420px;margin-top:12px;font-family:ui-monospace,Menlo,monospace;font-size:13px\"></textarea>\n  <p class=\"ks-muted\" style=\"font-size:11px;margin-bottom:0\">Multi-page demo route served at /files/edit — loads &amp; writes through the instance page SDK.</p>\n</div>\n\n<script>\n(function () {\n  'use strict';\n  var $ = function (id) { return document.getElementById(id); };\n  var status = function (msg, bad) {\n    var el = $('status');\n    el.textContent = msg;\n    el.style.color = bad ? '#fca5a5' : '#6ee7b7';\n  };\n  function boot(sdk) {\n    async function load() {\n      var p = $('path').value.trim();\n      if (!p) { status('enter a path first', true); return; }\n      try {\n        status('loading…');\n        // sdk.readFile resolves to the file content STRING (or rejects).\n        var res = await sdk.readFile(p);\n        var text = typeof res === 'string' ? res\n          : (res && res.content != null ? res.content\n          : (res && res.stdout != null ? res.stdout : ''));\n        $('editor').value = text;\n        status('loaded ' + p);\n      } catch (e) { status(String(e.message || e), true); }\n    }\n    async function save() {\n      var p = $('path').value.trim();\n      if (!p) { status('enter a path first', true); return; }\n      try {\n        status('saving…');\n        var res = await sdk.writeFile(p, $('editor').value);\n        if (res && res.ok === false) throw new Error(res.error || 'write failed');\n        status('saved ' + p);\n      } catch (e) { status(String(e.message || e), true); }\n    }\n    $('loadBtn').addEventListener('click', load);\n    $('saveBtn').addEventListener('click', save);\n    $('editor').addEventListener('keydown', function (ev) {\n      if ((ev.ctrlKey || ev.metaKey) && ev.key === 's') { ev.preventDefault(); save(); }\n    });\n    status('ready');\n    // Multi-page support: this page runs in a sandboxed iframe that cannot\n    // see the real panel URL, so CustomPageView injects the parent route's\n    // query string as KS_PAGE_QUERY. Opening /files/edit?path=/a/b.txt (what\n    // the Files listing does when a file is clicked) preloads the editor.\n    var qs = String(window.KS_PAGE_QUERY || '');\n    var mq = qs.match(/[?&]path=([^&]*)/);\n    if (mq) {\n      var qp = decodeURIComponent(mq[1]);\n      if (qp) { $('path').value = qp; load(); }\n    }\n  }\n  if (window.KSPageSDK) boot(window.KSPageSDK);\n  else window.addEventListener('ks-page-sdk-ready', function () { boot(window.KSPageSDK); }, { once: true });\n})();\n</script>",
