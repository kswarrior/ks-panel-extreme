{
  "name": "SSL Certificate Manager",
  "slug": "ssl-manager",
  "kind": "custom",
  "category": "security",
  "description": "Automated SSL certificate provisioning and renewal with Let's Encrypt",
  "content_type": "html",
  "content_html": "<div class=\"ks-page\">\n<div class=\"ks-row\" style=\"justify-content:space-between;margin-bottom:0.75rem\">\n  <h2 style=\"margin:0;font-size:1.3rem;color:var(--ks-heading)\">SSL Certificate Manager</h2>\n</div>\n<div id=\"content\" class=\"ks-muted\">Checking certbot…</div>\n<script>\n(function () {\n  'use strict';\n  var sdk = window.KSPageSDK;\n  if (!sdk) { document.getElementById('content').innerHTML = '<p class=\"ks-bad\">SDK unavailable.</p>'; return; }\n\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];});}\n  function el(id){return document.getElementById(id);}\n  function tok(n,f){try{var v=getComputedStyle(document.documentElement).getPropertyValue(n).trim();return v||f;}catch(e){return f;}}\n  function badge(s){var c='ks-badge';s=String(s==null?'':s).toLowerCase();if(['running','done','active','ok','up'].indexOf(s)>=0)c+=' ks-ok';else if(['stopped','exited','inactive','paused'].indexOf(s)>=0)c+=' ks-warn';else if(['errored','failed','error','dead'].indexOf(s)>=0)c+=' ks-bad';return '<span class=\"'+c+'\">'+esc(s||'unknown')+'</span>';}\n  function fmtBytes(n){if(n==null||isNaN(n))return'-';var u=['B','KB','MB','GB','TB'];var i=0;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n>=100||i===0?0:1)+' '+u[i];}\n  async function sh(cmd,timeout){var r=await KSPageSDK.shell(cmd,[],null,timeout||20);if(r&&r.error&&!r.stdout&&!r.stderr)throw new Error(r.error);return r;}\n\n  async function render() {\n    el('content').innerHTML = 'Checking certbot…';\n    try {\n      var chk = await sh('command -v certbot >/dev/null 2>&1 && echo yes || echo no', 10);\n      var hasCertbot = String(chk.stdout || '').trim() === 'yes';\n      if (!hasCertbot) {\n        el('content').innerHTML =\n          '<div class=\"ks-card\"><h3 style=\"margin:0 0 .5rem;font-size:.95rem;color:var(--ks-heading)\">certbot not installed</h3>' +\n          '<p class=\"ks-muted\" style=\"font-size:13px;margin:0 0 .75rem\">Install it inside this instance to manage Let\\'s Encrypt certificates:</p>' +\n          '<pre style=\"font-size:12px;margin:0\">apt-get update && apt-get install -y certbot   # Debian/Ubuntu\\nyum install -y certbot                          # RHEL-family\\napk add certbot                                  # Alpine</pre></div>';\n        return;\n      }\n      var certs = await sh('certbot certificates 2>&1', 30);\n      var renewBtn = '<div class=\"ks-card\"><div class=\"ks-row\" style=\"justify-content:space-between\">' +\n        '<h3 style=\"margin:0;font-size:.95rem;color:var(--ks-heading)\">Certificates</h3>' +\n        '<button class=\"ks-btn ks-btn-green\" id=\"renew\">Renew all</button></div>' +\n        '<pre style=\"max-height:300px;overflow:auto;font-size:12px;margin:.5rem 0 0\">' + esc(String(certs.stdout || '')) + '</pre></div>';\n      el('content').innerHTML = renewBtn +\n        '<div class=\"ks-card\"><h3 style=\"margin:0 0 .5rem;font-size:.95rem;color:var(--ks-heading)\">Issue new certificate</h3>' +\n        '<label for=\"domains\">Domains (space separated)</label>' +\n        '<input id=\"domains\" placeholder=\"example.com www.example.com\" spellcheck=\"false\" style=\"width:100%;margin-bottom:.5rem\" />' +\n        '<div class=\"ks-row\"><label for=\"email\" style=\"margin:0\">Email</label>' +\n        '<input id=\"email\" placeholder=\"admin@example.com\" spellcheck=\"false\" style=\"flex:1\" />' +\n        '<button class=\"ks-btn ks-btn-blue\" id=\"issue\">Issue</button></div>' +\n        '<p class=\"ks-muted\" style=\"font-size:11px;margin:.5rem 0 0\">Uses <span class=\"ks-mono\">certbot certonly --standalone</span>. Port 80 must be free while issuing.</p></div>';\n      el('renew').addEventListener('click', async function () {\n        if (!window.confirm('Run certbot renew now?')) return;\n        try { await sh('certbot renew 2>&1 | tail -20', 240); render(); }\n        catch (e) { KSPageSDK.toast('Renew failed: ' + ((e && e.message) || e), 'error'); }\n      });\n      el('issue').addEventListener('click', async function () {\n        var domains = el('domains').value.trim().split(/\\s+/).filter(Boolean);\n        var email = el('email').value.trim();\n        if (!domains.length || !email) { KSPageSDK.toast('Domains and email are required.', 'warning'); return; }\n        var cmd = 'certbot certonly --standalone --non-interactive --agree-tos -m ' + JSON.stringify(email) +\n          ' ' + domains.map(function (d) { return '-d ' + JSON.stringify(d); }).join(' ') + ' 2>&1 | tail -20';\n        if (!window.confirm('Issue certificate for: ' + domains.join(', ') + '?')) return;\n        try { await sh(cmd, 240); render(); }\n        catch (e) { KSPageSDK.toast('Issue failed: ' + ((e && e.message) || e), 'error'); }\n      });\n    } catch (e) {\n      el('content').innerHTML = '<p class=\"ks-bad\">Failed: ' + esc((e && e.message) || e) + '</p>';\n    }\n  }\n  render();\n\n})();\ndocument.currentScript.remove();\n</script>",
  "content_markdown": "",
  "content_blocks": "",
  "icon_svg": "<path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>"
}
