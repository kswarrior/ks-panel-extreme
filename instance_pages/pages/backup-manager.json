{
  "name": "Backup Manager",
  "slug": "backup-manager",
  "kind": "custom",
  "category": "operations",
  "description": "Schedule, monitor, and restore backups with a visual interface",
  "content_type": "html",
  "content_html": "<div class=\"ks-page\">\n<div class=\"ks-row\" style=\"justify-content:space-between;margin-bottom:0.75rem\">\n  <h2 style=\"margin:0;font-size:1.3rem;color:var(--ks-heading)\">Backup Manager</h2>\n</div>\n<div class=\"ks-card\">\n<h3 style=\"margin:0 0 .5rem;font-size:.95rem;color:var(--ks-heading)\">Create backup</h3>\n<div class=\"ks-row\">\n  <input id=\"src\" value=\"/etc /home\" spellcheck=\"false\" style=\"flex:1;min-width:200px\" />\n  <button class=\"ks-btn ks-btn-green\" id=\"create\">Back up now</button>\n</div>\n<p class=\"ks-muted\" style=\"font-size:11px;margin:.4rem 0 0\">Space-separated paths are packed into <span class=\"ks-mono\">/var/backups/backup-&lt;timestamp&gt;.tar.gz</span>.</p>\n</div>\n<div id=\"list\" class=\"ks-muted\" style=\"margin-top:0.75rem\">Loading backups…</div>\n<script>\n(function () {\n  'use strict';\n  var sdk = window.KSPageSDK;\n  if (!sdk) { document.getElementById('content').innerHTML = '<p class=\"ks-bad\">SDK unavailable.</p>'; return; }\n\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];});}\n  function el(id){return document.getElementById(id);}\n  function tok(n,f){try{var v=getComputedStyle(document.documentElement).getPropertyValue(n).trim();return v||f;}catch(e){return f;}}\n  function badge(s){var c='ks-badge';s=String(s==null?'':s).toLowerCase();if(['running','done','active','ok','up'].indexOf(s)>=0)c+=' ks-ok';else if(['stopped','exited','inactive','paused'].indexOf(s)>=0)c+=' ks-warn';else if(['errored','failed','error','dead'].indexOf(s)>=0)c+=' ks-bad';return '<span class=\"'+c+'\">'+esc(s||'unknown')+'</span>';}\n  function fmtBytes(n){if(n==null||isNaN(n))return'-';var u=['B','KB','MB','GB','TB'];var i=0;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n>=100||i===0?0:1)+' '+u[i];}\n  async function sh(cmd,timeout){var r=await KSPageSDK.shell(cmd,[],null,timeout||20);if(r&&r.error&&!r.stdout&&!r.stderr)throw new Error(r.error);return r;}\n\n  var DIR = '/var/backups';\n  function row(name, size) {\n    return '<tr><td class=\"ks-mono\">' + esc(name) + '</td><td class=\"ks-mono\">' + fmtBytes(size) + '</td>' +\n      '<td><a href=\"#\" data-restore=\"' + esc(name) + '\">restore</a> &nbsp; <a href=\"#\" data-del=\"' + esc(name) + '\" class=\"ks-bad\">delete</a></td></tr>';\n  }\n  async function load() {\n    el('list').innerHTML = 'Loading backups…';\n    try {\n      var r = await sh('ls -la ' + JSON.stringify(DIR) + ' 2>/dev/null | awk \\'$NF ~ /\\\\.tar\\\\.gz$/ {print $5, $NF}\\' || true', 15);\n      var rows = String(r.stdout || '').trim().split('\\n').filter(Boolean).map(function (line) {\n        var parts = line.split(/\\s+/); return row(parts[1] || parts[0], Number(parts[0]) || 0);\n      });\n      el('list').innerHTML = rows.length\n        ? '<div class=\"ks-card\" style=\"padding:0\"><table><thead><tr><th>File</th><th>Size</th><th>Actions</th></tr></thead><tbody>' + rows.join('') + '</tbody></table></div>'\n        : '<p class=\"ks-muted\">No backups in ' + esc(DIR) + ' yet.</p>';\n    } catch (e) { el('list').innerHTML = '<p class=\"ks-bad\">Failed to list backups: ' + esc((e && e.message) || e) + '</p>'; }\n  }\n  async function create() {\n    var srcs = el('src').value.trim();\n    if (!srcs) return;\n    var dest = DIR + '/backup-' + new Date().toISOString().replace(/[:.]/g, '-') + '.tar.gz';\n    if (!window.confirm('Create backup of \"' + srcs + '\" at ' + dest + '?')) return;\n    el('list').innerHTML = '<p class=\"ks-muted\">Creating backup…</p>';\n    try {\n      var cmd = 'mkdir -p ' + JSON.stringify(DIR) + ' && tar czf ' + JSON.stringify(dest) + ' --absolute-names ' + srcs.split(/\\s+/).map(JSON.stringify).join(' ') + ' 2>&1 | tail -5';\n      var r = await sh(cmd, 120);\n      toast('Backup created: ' + dest, 'success');\n      void r;\n      load();\n    } catch (e) { el('list').innerHTML = '<p class=\"ks-bad\">Backup failed: ' + esc((e && e.message) || e) + '</p>'; }\n  }\n  async function restore(name) {\n    if (!window.confirm('Restore ' + name + ' over the original paths? This overwrites existing files.')) return;\n    try {\n      await sh('tar xzf ' + JSON.stringify(DIR + '/' + name) + ' --absolute-names 2>&1 | tail -5', 120);\n      toast('Restore finished: ' + name, 'success');\n    } catch (e) { toast('Restore failed: ' + ((e && e.message) || e), 'error'); }\n  }\n  async function del(name) {\n    if (!window.confirm('Delete backup ' + name + '?')) return;\n    try {\n      await sh('rm -f ' + JSON.stringify(DIR + '/' + name), 15);\n      load();\n    } catch (e) { toast('Delete failed: ' + ((e && e.message) || e), 'error'); }\n  }\n  el('create').addEventListener('click', create);\n  el('list').addEventListener('click', function (ev) {\n    var a = ev.target.closest('a'); if (!a) return;\n    ev.preventDefault();\n    if (a.dataset.restore) restore(a.dataset.restore);\n    else if (a.dataset.del) del(a.dataset.del);\n  });\n  function toast(m, t) { try { KSPageSDK.toast(m, t || 'info'); } catch (e) {} }\n  load();\n\n})();\ndocument.currentScript.remove();\n</script>",
  "content_markdown": "",
  "content_blocks": "",
  "icon_svg": "<path d=\"M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11\"/><polyline points=\"17 3 21 3 21 7\"/><path d=\"M21 12l-9 9-4-4\"/>"
}
