{
  "name": "Plugin Manager",
  "slug": "mc-plugins",
  "kind": "custom",
  "category": "minecraft",
  "description": "Manage plugins/ via list_files table + wget {{args}} -P plugins/ / rm plugins/{{args}}.jar + write_file plugins/ExamplePlugin/config.yml + touch restart.flag.",
  "content_type": "html",
  "content_html": "<div class=\"ks-page\">\n<div class=\"ks-page-header\"><h2 style=\"margin:0;font-size:1.3rem;color:var(--ks-heading)\">Plugin Manager</h2><button class=\"ks-btn-header ks-icon-btn\" id=\"btnRestart\" title=\"Touch restart.flag\">Restart</button></div>\n<div class=\"ks-row\" style=\"margin-bottom:0.6rem;gap:8px;flex-wrap:wrap\"><input id=\"pluginUrl\" class=\"ks-input\" placeholder=\"https://example.com/plugin.jar or name for rm\" style=\"flex:1;min-width:200px\" /><button class=\"ks-btn ks-btn-sm\" id=\"btnInstall\">wget to plugins/</button><button class=\"ks-btn ks-btn-sm ks-btn-danger\" id=\"btnRemove\">rm .jar</button></div>\n<div class=\"ks-row\" style=\"margin-bottom:0.6rem;gap:8px;flex-wrap:wrap\"><input id=\"configPath\" class=\"ks-input\" value=\"plugins/ExamplePlugin/config.yml\" style=\"flex:1;min-width:200px\" /><input id=\"configContent\" class=\"ks-input\" value=\"enable: true\" style=\"flex:1;min-width:140px\" /><button class=\"ks-btn ks-btn-sm ks-btn-secondary\" id=\"btnWriteConfig\">Write config</button></div>\n<div id=\"content\" class=\"ks-card\">Loading plugins/...</div><div id=\"out\" style=\"display:none;margin-top:0.75rem\"></div>\n</div>\n<script>\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];});}\nfunction pre(t){return '<pre style=\"max-height:320px;overflow:auto;font-size:12px;background:var(--ks-input-bg);border:1px solid var(--ks-card-border);color:var(--ks-body);border-radius:6px;padding:0.75rem\">'+esc(t)+'</pre>';}\nasync function load(){ try{ var r=await KSPageSDK.runAction('list_plugins'); var d=r.data||r.stdout||''; var rows=Array.isArray(d)? d : String(d).split('\\n').filter(Boolean).map(function(l){return {name:l.trim()};}); var html='<table><thead><tr><th>Name</th><th>Size</th></tr></thead><tbody>'+rows.map(function(f){return '<tr><td>'+esc(f.name)+'</td><td>'+esc(String(f.size||''))+'</td></tr>';}).join('')+'</tbody></table>'; document.getElementById('content').innerHTML='<div class=\"ks-card\"><h3>plugins/</h3>'+html+'</div>'; }catch(e){ document.getElementById('content').innerHTML='<p class=\"ks-bad\">'+esc(e.message)+'</p>'; } }\ndocument.getElementById('btnRestart').onclick=async function(){ if(!confirm('Touch restart.flag?')) return; try{ var r=await KSPageSDK.runAction('restart_flag'); alert('exit '+(r.exit_code!=null?r.exit_code:'?'));}catch(e){alert(e.message);} };\ndocument.getElementById('btnInstall').onclick=async function(){ var v=document.getElementById('pluginUrl').value.trim(); if(!v) return; if(!confirm('wget '+v+' into plugins/?')) return; try{ var r=await KSPageSDK.runAction('install_plugin',{args:[v]}); document.getElementById('out').style.display='block'; document.getElementById('out').innerHTML='<div class=\"ks-card\"><h3>wget</h3>'+pre((r.stdout||'')+(r.stderr||''))+'</div>'; load(); }catch(e){alert(e.message);} };\ndocument.getElementById('btnRemove').onclick=async function(){ var v=document.getElementById('pluginUrl').value.trim(); if(!v) return; var name=v.replace(/\\.jar$/,''); if(!confirm('rm plugins/'+name+'.jar ?')) return; try{ var r=await KSPageSDK.runAction('remove_plugin',{args:[name]}); document.getElementById('out').style.display='block'; document.getElementById('out').innerHTML='<div class=\"ks-card\"><h3>rm</h3>'+pre((r.stdout||'')+(r.stderr||''))+'</div>'; load(); }catch(e){alert(e.message);} };\ndocument.getElementById('btnWriteConfig').onclick=async function(){ try{ var r=await KSPageSDK.runAction('write_plugin_config'); alert('exit '+(r.exit_code!=null?r.exit_code:'?'));}catch(e){alert(e.message);} };\nload();\n</script>",
  "content_markdown": "",
  "content_blocks": "",
  "icon_svg": "<path d=\"M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8z\"/><path d=\"M12 8V6a4 4 0 0 0-4-4 4 4 0 0 0-4 4v2\"/><path d=\"M9 21h6\"/><path d=\"M18 9a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3h-1\"/>",
  "actions": "[{\"name\": \"list_plugins\", \"type\": \"list_files\", \"path\": \"plugins\", \"description\": \"Table plugins/ via list_files.\"}, {\"name\": \"list_plugins_root\", \"type\": \"list_files\", \"path\": \"plugins/\", \"description\": \"List plugins/ with trailing slash.\"}, {\"name\": \"install_plugin\", \"type\": \"shell\", \"command\": \"wget {{args}} -P plugins/\", \"open_args\": true, \"description\": \"Install plugin via wget {{args}} -P plugins/ (validated validActionArg).\"}, {\"name\": \"remove_plugin\", \"type\": \"shell\", \"command\": \"rm plugins/{{args}}.jar\", \"open_args\": true, \"description\": \"Remove plugin jar via rm plugins/{{args}}.jar.\"}, {\"name\": \"write_plugin_config\", \"type\": \"write_file\", \"path\": \"plugins/ExamplePlugin/config.yml\", \"content\": \"# ExamplePlugin config.yml\\n# Edit in Studio to customize for your plugin\\nname: ExamplePlugin\\nversion: 1.0.0\\nenabled: true\\nsettings:\\n  example: true\\n  max-players: 20\\n\", \"description\": \"Write plugins/ExamplePlugin/config.yml (write_file).\"}, {\"name\": \"restart_flag\", \"type\": \"shell\", \"command\": \"touch restart.flag && echo restart scheduled via restart.flag\", \"description\": \"Restart action via touch restart.flag (server watches for flag or install exposes screen/rcon).\"}]"
}
