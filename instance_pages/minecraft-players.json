{
  "name": "Player Manager",
  "slug": "mc-players",
  "kind": "custom",
  "category": "minecraft",
  "description": "Read whitelist.json/ops.json/banned-players.json tables and manage players via whitelist/op/ban (rcon/screen) + list_files world/playerdata.",
  "content_type": "html",
  "content_html": "<div class=\"ks-page\">\n<div class=\"ks-page-header\"><h2 style=\"margin:0;font-size:1.3rem;color:var(--ks-heading)\">Player Manager</h2><span class=\"ks-muted\" style=\"font-size:11px\">whitelist / ops / banned + world/playerdata</span></div>\n<div class=\"ks-row\" style=\"margin-bottom:0.6rem;gap:8px;flex-wrap:wrap\"><input id=\"playerInput\" class=\"ks-input\" placeholder=\"player name\" style=\"flex:1;min-width:140px;max-width:200px\" /><button class=\"ks-btn ks-btn-sm\" id=\"btnWhitelist\">Whitelist Add</button><button class=\"ks-btn ks-btn-sm\" id=\"btnOp\">Op</button><button class=\"ks-btn ks-btn-sm ks-btn-danger\" id=\"btnBan\">Ban</button></div>\n<div id=\"content\" class=\"ks-card\">Loading...</div><div id=\"playerdata\" style=\"margin-top:12px\"></div>\n</div>\n<script>\nasync function load(){\n  var w='',o='',b='',pd='';\n  try{ var r=await KSPageSDK.runAction('read_whitelist'); w=(r.data||r.stdout||'')+''; }catch(e){ w='whitelist.json: '+e.message; }\n  try{ var r2=await KSPageSDK.runAction('read_ops'); o=(r2.data||r2.stdout||'')+''; }catch(e){ o='ops.json: '+e.message; }\n  try{ var r3=await KSPageSDK.runAction('read_banned'); b=(r3.data||r3.stdout||'')+''; }catch(e){ b='banned-players.json: '+e.message; }\n  try{ var r4=await KSPageSDK.runAction('list_playerdata'); pd=JSON.stringify(r4.data||r4.stdout||'',null,2); }catch(e){ pd='world/playerdata: '+e.message; }\n  function esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];});}\n  function pre(t){return '<pre style=\"max-height:320px;overflow:auto;font-size:12px;background:var(--ks-input-bg);border:1px solid var(--ks-card-border);color:var(--ks-body);border-radius:6px;padding:0.75rem\">'+esc(t)+'</pre>';}\n  document.getElementById('content').innerHTML = '<div class=\"ks-card\"><h3>Whitelist</h3>'+pre(w)+'</div><div class=\"ks-card\"><h3>Ops</h3>'+pre(o)+'</div><div class=\"ks-card\"><h3>Banned</h3>'+pre(b)+'</div>';\n  document.getElementById('playerdata').innerHTML = '<div class=\"ks-card\"><h3>world/playerdata</h3>'+pre(pd)+'</div>';\n}\ndocument.getElementById('btnWhitelist').onclick = async function(){ var v=document.getElementById('playerInput').value.trim(); if(!v) return; if(!confirm('whitelist add '+v+'?')) return; try{ var r=await KSPageSDK.runAction('whitelist_add',{args:[v]}); alert('exit '+(r.exit_code!=null?r.exit_code:'?'));}catch(e){ alert(e.message);} load(); };\ndocument.getElementById('btnOp').onclick = async function(){ var v=document.getElementById('playerInput').value.trim(); if(!v) return; if(!confirm('op '+v+'?')) return; try{ var r=await KSPageSDK.runAction('op_player',{args:[v]}); alert('exit '+(r.exit_code!=null?r.exit_code:'?'));}catch(e){ alert(e.message);} load(); };\ndocument.getElementById('btnBan').onclick = async function(){ var v=document.getElementById('playerInput').value.trim(); if(!v) return; if(!confirm('ban '+v+'?')) return; try{ var r=await KSPageSDK.runAction('ban_player',{args:[v]}); alert('exit '+(r.exit_code!=null?r.exit_code:'?'));}catch(e){ alert(e.message);} load(); };\nload();\n</script>",
  "content_markdown": "",
  "content_blocks": "",
  "icon_svg": "<path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/>",
  "actions": "[{\"name\": \"read_whitelist\", \"type\": \"read_file\", \"path\": \"whitelist.json\", \"description\": \"Read whitelist.json table.\"}, {\"name\": \"read_ops\", \"type\": \"read_file\", \"path\": \"ops.json\", \"description\": \"Read ops.json table.\"}, {\"name\": \"read_banned\", \"type\": \"read_file\", \"path\": \"banned-players.json\", \"description\": \"Read banned-players.json table.\"}, {\"name\": \"list_playerdata\", \"type\": \"list_files\", \"path\": \"world/playerdata\", \"description\": \"List world/playerdata via list_files.\"}, {\"name\": \"whitelist_add\", \"type\": \"shell\", \"command\": \"whitelist add {{args}}\", \"open_args\": true, \"description\": \"whitelist add <player> via rcon or screen (install must expose it).\"}, {\"name\": \"op_player\", \"type\": \"shell\", \"command\": \"op {{args}}\", \"open_args\": true, \"description\": \"op <player> via rcon or screen.\"}, {\"name\": \"ban_player\", \"type\": \"shell\", \"command\": \"ban {{args}}\", \"open_args\": true, \"description\": \"ban <player> via rcon or screen.\"}]"
}
